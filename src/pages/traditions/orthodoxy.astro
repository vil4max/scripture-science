---
import { withBase } from '../../lib/paths';
const destination = withBase('orthodoxy/');
---
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <title>Православная вера</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(destination, Astro.site).href} />
    <meta http-equiv="refresh" content={`0; url=${destination}`} />
    <script is:inline define:vars={{ destination }}>
      const target = new URL(destination, location.origin);
      target.search = location.search;
      target.hash = location.hash;
      location.replace(target.href);
    </script>
  </head>
  <body><p><a href={destination}>Православная вера</a></p></body>
</html>
