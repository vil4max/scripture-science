---
import TraditionProfile from '../../components/TraditionProfile.astro';
import { getOrderedMatrix } from '../../lib/content';
import { TRADITION_IDS } from '../../lib/rules';

// Orthodoxy has its own page, /orthodoxy/; /traditions/orthodoxy/ redirects there.
export async function getStaticPaths() {
  const traditions = await getOrderedMatrix();
  return TRADITION_IDS.filter((id) => id !== 'orthodoxy').map((id) => {
    const tradition = traditions.find((entry) => entry.id === id);
    if (!tradition) throw new Error(`Missing matrix entry for profile: ${id}`);
    return { params: { id }, props: { tradition } };
  });
}

const { tradition } = Astro.props;
---
<TraditionProfile tradition={tradition} />
