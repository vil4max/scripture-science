---
import CompareAnchors from '../components/CompareAnchors.astro';
import BackToTop from '../components/BackToTop.astro';
import QuestionCompare from '../components/QuestionCompare.astro';
import SectionPage from '../layouts/SectionPage.astro';
import JourneyNav from '../components/JourneyNav.astro';
import { getOrderedMatrix } from '../lib/content';
import { withBase } from '../lib/paths';
import { TRADITION_COLOR_TOKEN } from '../lib/rules';

const traditions = await getOrderedMatrix();
const colorById = new Map(
  traditions.map((t) => [t.id, TRADITION_COLOR_TOKEN[t.id as keyof typeof TRADITION_COLOR_TOKEN]]),
);
---

<SectionPage
  title="Сравнение"
  lead="Пятнадцать главных вопросов веры. На каждый — сначала ответ Православной Церкви, затем учение выбранной религии и в чём разница."
>
  <JourneyNav />
  <p id="views" class="views-note">Отвергая ошибочные учения, христианин призван любить людей, которые их исповедуют (<a href="https://azbyka.ru/otechnik/dokumenty/osnovnye-printsipy-otnoshenija-russkoj-pravoslavnoj-tserkvi-k-inoslaviyu/">Основные принципы отношения РПЦ к инославию, 2000, §§1.1, 7.1</a>). Ответные документы других традиций — в <a href={withBase('sources/#relations-documents')}>справочных материалах</a>.</p>

  <CompareAnchors />
  <section id="topics" aria-label="Вопросы сравнения">
    <QuestionCompare traditions={traditions} colorById={colorById} />
  </section>

  <p class="reference-link">Подробные разборы каждой религии — на её странице; исторические события — в разделе <a href={withBase('timeline/')}>«История»</a>; источники — в <a href={withBase('sources/')}>справочном разделе</a>.</p>
  <BackToTop />
</SectionPage>

<style>
  .views-note { max-width: var(--measure); margin: 0; padding-left: 14px; border-left: 4px solid var(--t-orthodoxy); color: var(--muted); font-size: 15px; line-height: 1.6; }
  .views-note a, .reference-link a { color: var(--focus); }
  .reference-link { color: var(--muted); font-size: 15px; }
</style>
