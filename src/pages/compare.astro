---
import CompareAnchors from '../components/CompareAnchors.astro';
import BackToTop from '../components/BackToTop.astro';
import QuestionCompare from '../components/QuestionCompare.astro';
import SectionPage from '../layouts/SectionPage.astro';
import { getOrderedMatrix } from '../lib/content';
import { CREED_SOURCE } from '../lib/creed';
import { withBase } from '../lib/paths';
import { TRADITION_COLOR_TOKEN } from '../lib/rules';

const traditions = await getOrderedMatrix();
const colorById = new Map(
  traditions.map((t) => [t.id, TRADITION_COLOR_TOKEN[t.id as keyof typeof TRADITION_COLOR_TOKEN]]),
);
---

<SectionPage
  title="Символ веры и различия"
  lead="Символ веры — краткое исповедание православной веры. По каждому его члену: что говорят другие религии и православный взгляд на расхождение. Затем — другие различия, о которых Символ веры не говорит."
>
  <p id="views" class="views-note">Символ веры составили отцы I и II Вселенских Соборов; <a href={withBase('worship/#simvol-very')}>полный текст</a> — в разделе «Богослужение и молитва» (<a href={CREED_SOURCE.url} target="_blank" rel="noopener noreferrer">{CREED_SOURCE.title}</a>). Отвергая ошибочные учения, христианин призван любить людей, которые их исповедуют (<a href="https://azbyka.ru/otechnik/dokumenty/osnovnye-printsipy-otnoshenija-russkoj-pravoslavnoj-tserkvi-k-inoslaviyu/">Основные принципы отношения РПЦ к инославию, 2000, §§1.1, 7.1</a>).</p>

  <CompareAnchors />
  <section id="topics" aria-label="Символ веры и различия">
    <QuestionCompare traditions={traditions} colorById={colorById} />
  </section>

  <p class="reference-link">Как служат и молятся в каждой религии — в разделе <a href={withBase('worship/')} data-carry-selection>«Богослужение и молитва»</a>; подробные разборы каждой религии — на её странице; исторические события — в разделе <a href={withBase('timeline/')}>«История»</a>; источники и ответные документы других традиций — в <a href={withBase('sources/#relations-documents')}>справочном разделе</a>.</p>
  <BackToTop />
</SectionPage>

<style>
  .views-note { max-width: var(--measure); margin: 0; padding-left: 14px; border-left: 4px solid var(--t-orthodoxy); color: var(--muted); font-size: 15px; line-height: 1.6; }
  .views-note a, .reference-link a { color: var(--focus); }
  .reference-link { color: var(--muted); font-size: 15px; }
</style>
