---
import CompareAnchors from '../components/CompareAnchors.astro';
import ColumnHeader from '../components/ColumnHeader.astro';
import Comparison from '../components/Comparison.astro';
import TraditionCompare from '../components/TraditionCompare.astro';
import SectionPage from '../layouts/SectionPage.astro';
import { getDisputes, getOrderedMatrix } from '../lib/content';
import { withBase } from '../lib/paths';
import { TRADITION_COLOR_TOKEN } from '../lib/rules';

const traditions = await getOrderedMatrix();
const colorById = new Map(
  traditions.map((t) => [t.id, TRADITION_COLOR_TOKEN[t.id as keyof typeof TRADITION_COLOR_TOKEN]]),
);
const disputes = await getDisputes();
---

<SectionPage
  title="Сравнение"
  lead="Православное учение → В чём отличие → Православный ответ. Православие закреплено первым; две другие колонки можно изменить или очистить."
>
  <ColumnHeader traditions={traditions} colorById={colorById} />
  <CompareAnchors />
  <nav class="reading-nav" aria-label="Разделы сравнения">
    <a href="#chosen">Основные сведения</a><a href="#topics">Вера и практика</a><a href="#views">Отношения между традициями</a>
  </nav>
  <TraditionCompare traditions={traditions} />

  <section id="topics">
    <h2>Вера и практика</h2>
    {
      traditions.length > 0 ? (
        <Comparison traditions={traditions} colorById={colorById} disputes={disputes} />
      ) : (
        <p class="empty">Данные для сравнения ещё готовятся.</p>
      )
    }
  </section>

  <section id="views">
    <h2>Отношения между традициями</h2>
    <p>Православная Церковь свидетельствует о единстве Церкви Христовой. Отвергая ошибочные учения, христианин призван любить людей, которые их исповедуют. Конкретные вероучительные различия разобраны выше, рядом с каждым вопросом.</p>
    <p><a href="https://azbyka.ru/otechnik/dokumenty/osnovnye-printsipy-otnoshenija-russkoj-pravoslavnoj-tserkvi-k-inoslaviyu/">Основные принципы отношения Русской Православной Церкви к инославию, 2000, §§1.1, 7.1</a>. Ответные документы других традиций сохранены в <a href={withBase('sources/#relations-documents')}>справочных материалах</a>.</p>
  </section>

  <p class="reference-link">Исторические события — в разделе <a href={withBase('timeline/')}>«История»</a>, справочные материалы — в разделе <a href={withBase('sources/')}>«Термины и источники»</a>.</p>
</SectionPage>

<script>
  import { onSelection } from '../lib/selection-client';

  onSelection((ids) => {
    for (const id of ['topics', 'views']) {
      const section = document.getElementById(id);
      if (section) section.hidden = ids.length === 0;
    }
  });
</script>

<style>
  .reading-nav { display: flex; flex-wrap: wrap; gap: 12px 24px; font-size: 15px; }
  .reading-nav a, .reference-link a { color: var(--focus); }
  .reference-link { color: var(--muted); font-size: 15px; }
  #views, #topics {
    scroll-margin-top: calc(var(--comparison-header-h, 0px) + 16px);
  }
</style>
