---
import { withBase } from '../lib/paths';
const destination = withBase('sources/');
---
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <title>Термины и источники</title>
    <link rel="canonical" href={`${destination}#terms`} />
    <script is:inline define:vars={{ destination }}>
      const target = new URL(destination, location.origin);
      target.search = location.search;
      target.hash = 'terms';
      location.replace(target.href);
    </script>
  </head>
  <body><p><a href={`${destination}#terms`}>Термины и источники</a></p></body>
</html>
