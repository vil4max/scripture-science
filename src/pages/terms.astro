---
// «Термины» (docs/tasks/site-m13-sidebar-sections.md): the words the site
// uses and how each tradition and scholarship use them.
import TermsBox from '../components/TermsBox.astro';
import SectionPage from '../layouts/SectionPage.astro';
import { getTerms } from '../lib/content';

const terms = await getTerms();
---

<SectionPage
  title="Термины"
  lead="Слова, которыми пользуется сайт, и как их понимают сами традиции и религиоведение."
  jwNote
>
  {terms.length > 0 ? <TermsBox terms={terms} /> : <p class="empty">Раздел ещё готовится.</p>}
</SectionPage>
