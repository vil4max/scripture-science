---
import { getPairDocument } from '../lib/pairDocument';
import { assessments } from '../lib/orthodox';
import classifications from '../data/orthodox-classifications.json';
import ViewTile from '../components/ViewTile.astro';
import { withBase } from '../lib/paths';
import { getFamilies } from '../lib/families';
import { buildSourceCatalog, collectAnalysisSources, collectProofs, collectTextSources, filterSourceCatalog, sourceAnchor, READING_KIND_LABELS, type CatalogRecord } from '../lib/sourceCatalog';
import SourceCatalogList from '../components/SourceCatalogList.astro';
import SourceFilters from '../components/SourceFilters.astro';
import { getAnalyses, profileHref } from '../lib/analysis';
import countries from '../data/world-countries.json';
import christianTraditions from '../data/world-christian-traditions.json';
import hierarchy from '../data/world-hierarchy-2026.json';
import history from '../data/history-overview.json';
import biblical from '../data/biblical-timeline.json';
import otherTraditions from '../data/other-traditions.json';
import world from '../data/world-composition.json';
import lineage from '../data/lineage.json';
import media from '../data/media.json';
import bible from '../data/bible-guide.json';
import CreationTraditions from '../components/timeline/CreationTraditions.astro';
import WorldComposition from '../components/WorldComposition.astro';
import WorldMethodology from '../components/WorldMethodology.astro';
import { JW_NOTE_TEXT } from '../lib/jwNote';
import overview from '../data/family-overview.json';
import Base from '../layouts/Base.astro';
import TermsBox from '../components/TermsBox.astro';
import { getDisputes, getOrderedMatrix, getOrderedViews, getTerms } from '../lib/content';
import { TOPIC_ORDER, TOPIC_TITLES_RU, TRADITION_COLOR_TOKEN } from '../lib/rules';

const { sectionHtml: pairSections, corrections: pairCorrections } = await getPairDocument();
const traditions = await getOrderedMatrix();
// src/lib/rules.ts TRADITION_COLOR_TOKEN: same shared --t-* palette as the
// home page (docs/tasks/site-m5-reading-polish.md W3 "Colours").
const colorById = new Map(
  traditions.map((t) => [t.id, TRADITION_COLOR_TOKEN[t.id as keyof typeof TRADITION_COLOR_TOKEN]]),
);
const views = await getOrderedViews();
const namesById = new Map(traditions.map(entry => [entry.id, entry.data.name]));
const orthodox = traditions.find(entry => entry.id === 'orthodoxy')!;
const terms = await getTerms();
const disputes = await getDisputes();
const analyses = (await getAnalyses()).map((entry) => entry.data);
const furtherReading = analyses.flatMap((analysis) => analysis.groups.flatMap((group) => group.cards.flatMap((card) =>
  card.more.map((item) => ({ ...item, tradition: analysis.tradition, cardId: card.id, cardTitle: card.title })),
)));
const textSources = [...new Map(
  collectTextSources([...traditions, ...views, ...disputes]).map((item) => [item.url, item]),
).values()].sort((a, b) => a.title.localeCompare(b.title, 'ru'));

// Keep claim attribution before grouping by URL and deduplicating complete proof tuples.
const raw: CatalogRecord[] = collectAnalysisSources(analyses, namesById);
raw.push({
  proof: {
    url: countries.url, title: 'Pew — Country composition, 2020', tier: 'reference',
    accessed: countries.accessed,
    excerpt: 'This interactive table shows the religious makeup of 201 countries and territories.',
  },
  usage: { section: 'Карта религиозной принадлежности' },
});

for (const tradition of traditions) {
  const t = tradition.data;
  const traditionName = t.name;
  for (const p of t.since.proof) raw.push({ proof: p, usage: { traditionId: tradition.id, traditionName, section: 'с …' } });
  for (const p of t.scripture.proof) raw.push({ proof: p, usage: { traditionId: tradition.id, traditionName, section: 'Писание' } });
  for (const p of t.adherents.proof) raw.push({ proof: p, usage: { traditionId: tradition.id, traditionName, section: 'Численность' } });
  for (const p of t.self_view.proof) raw.push({ proof: p, usage: { traditionId: tradition.id, traditionName, section: 'Сама о себе' } });
  for (const position of t.positions) {
    for (const p of collectProofs(position)) {
      raw.push({
        proof: p,
        usage: { traditionId: tradition.id, traditionName, topic: position.topic, section: 'Сравнение' },
      });
    }
  }
}

for (const view of views) {
  for (const doc of view.data.documents) {
    for (const p of collectProofs(doc)) {
      raw.push({
        proof: p,
        usage: { traditionId: view.id, traditionName: view.data.tradition, section: `взгляд на: ${doc.about.join(', ')}` },
      });
    }
  }
}

for (const dispute of disputes) {
  for (const part of [...dispute.data.challenges, ...dispute.data.answers]) {
    const traditionName = traditions.find((t) => t.id === part.tradition)?.data.name;
    for (const p of collectProofs(part)) {
      raw.push({
        proof: p,
        usage: { traditionId: part.tradition, traditionName, topic: dispute.data.topic, section: `спорный вопрос «${dispute.data.title}»` },
      });
    }
  }
}

for (const term of terms) {
  for (const p of term.data.proof) {
    raw.push({ proof: p, usage: { section: `термин «${term.data.term}»` } });
  }
}

for (const family of getFamilies()) {
  for (const proof of family.proof) raw.push({ proof, usage: {
    traditionId: family.tradition,
    traditionName: traditions.find((t) => t.id === family.tradition)?.data.name,
    section: 'Классификация',
  } });
}
for (const [section, data] of [
  ['Библейская линия: выбранная хронология', biblical], ['Авраамические религии', overview], ['Вводная история', history], ['Другие традиции', otherTraditions],
  ['Библия', bible],
  ['Население мира', world], ['Религии и конфессии, оценка 2026', hierarchy], ['Подробная хронология', lineage],
] as const) {
  for (const proof of collectProofs(data)) raw.push({ proof, usage: { section } });
}

for (const record of assessments) {
  for (const [role, proofs] of [['tradition', record.positionProof], ['answer', record.proof]] as const) {
    for (const proof of collectProofs(proofs)) raw.push({ proof, usage: {
      traditionId: record.tradition, traditionName: namesById.get(record.tradition),
      topic: record.topic, section: 'Православная оценка', role,
    } });
  }
}
const entries = buildSourceCatalog(raw);
if (new Set(entries.map((entry) => sourceAnchor(entry.url))).size !== entries.length) throw new Error('Duplicate source anchor');

const byTradition = new Map(
  traditions.map((tradition) => [
    tradition.id,
    filterSourceCatalog(entries, (usage) => usage.traditionId === tradition.id),
  ]),
);

const analysisCoverage = analyses.map((analysis) => {
  const cards = analysis.groups.flatMap((group) => group.cards);
  return {
    id: analysis.tradition, name: namesById.get(analysis.tradition), total: cards.length,
    verified: cards.filter((card) => card.status === 'verified').length,
    todo: cards.filter((card) => card.status === 'todo').length,
  };
});
const coverageByTradition = traditions.map((tradition) => {
  const verified = tradition.data.positions.filter((p) => p.status === 'verified').length;
  const todo = tradition.data.positions.filter((p) => p.status === 'todo').length;
  return { id: tradition.id, name: tradition.data.name, verified, todo, total: tradition.data.positions.length };
});

const coverageByTopic = TOPIC_ORDER.map((topicId) => {
  let verified = 0;
  let todo = 0;
  for (const tradition of traditions) {
    const position = tradition.data.positions.find((p) => p.topic === topicId);
    if (!position) continue;
    if (position.status === 'verified') verified += 1;
    else todo += 1;
  }
  return { topicId, title: TOPIC_TITLES_RU[topicId], verified, todo };
});

const title = 'Термины и источники';
const description = 'Значения слов, пояснения к данным и источники материалов сайта.';
---

<Base title={title} description={description}>
  <main class="page">
    <header>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <nav class="reference-sections" aria-label="На этой странице">
        <div><strong>Термины</strong><ul><li><a href="#terms">Словарь</a></li></ul></div>
        <div><strong>Пояснения по разделам</strong><ul>
          <li><a href="#adherents">Численность</a></li><li><a href="#map-method">Карта</a></li>
          <li><a href="#history-evidence">История и хронология</a></li>
          <li><a href="#overview-notes">Группировка традиций</a></li><li><a href="#legal-context">Правовая справка</a></li>
        </ul></div>
        <div><strong>Источники</strong><ul>
          <li><a href="#by-topic">Православное основание и источники по темам</a></li><li><a href="#by-tradition">По традициям</a></li><li><a href="#texts">Тексты и переводы</a></li>
          <li><a href="#data-and-media">Данные и изображения</a></li><li><a href="#by-tier">Полный каталог</a></li><li><a href="#coverage">Покрытие</a></li><li><a href="#pair-reference">Материалы сравнения православия и Свидетелей Иеговы</a></li>
        </ul></div>
      </nav>
    </header>

    <section id="by-tier">
      <h2>Найти источник</h2>
      <p>Фильтр «Разбор традиции» выбирает, к какому разбору относится выдержка. В нём могут использоваться и собственные документы традиции, и православные источники.</p>
      <SourceFilters traditions={traditions.map((entry) => ({ id: entry.id, name: entry.data.name }))} />
      <SourceCatalogList entries={entries} detailed />
    </section>

    <section id="terms" aria-labelledby="terms-title">
      <h2 id="terms-title">Термины</h2>
      <TermsBox terms={terms} />
    </section>

    <section id="by-topic"><h2>Православное основание и источники по темам</h2>
      <p>Символ веры, Писание, соборные определения и катехизис составляют вероучительное основание. Энциклопедические статьи и авторские толкования поясняют его; местная практика не становится общецерковным догматом.</p>
      {TOPIC_ORDER.map(topic => {
        const foundation = orthodox.data.positions.find(position => position.topic === topic)!;
        const records = assessments.filter(record => record.topic === topic);
        return <section id={`sources-${topic}`}><h3>{TOPIC_TITLES_RU[topic]}</h3><p>{foundation.doctrine?.authority}</p>
          <details class="source-topic"><summary>Православное учение: места и проверочные выдержки</summary>
            <SourceCatalogList entries={filterSourceCatalog(entries, (usage) => usage.traditionId === 'orthodoxy' && usage.topic === topic && usage.section === 'Сравнение')} />
          </details>
          {records.map(record => <details class="source-topic">
            <summary>{namesById.get(record.tradition)}: учение и православный ответ</summary>
            <p><strong>В чём отличие:</strong> {record.difference}</p>
            <p><strong>Православный ответ:</strong> {record.response}</p>
            <h4>Документы традиции</h4>
            <SourceCatalogList entries={filterSourceCatalog(entries, (usage) => usage.traditionId === record.tradition && usage.topic === topic && usage.section === 'Православная оценка' && usage.role === 'tradition')} />
            <h4>Основание ответа</h4><p>{record.authority}</p>
            <SourceCatalogList entries={filterSourceCatalog(entries, (usage) => usage.traditionId === record.tradition && usage.topic === topic && usage.section === 'Православная оценка' && usage.role === 'answer')} />
          </details>)}
          <details class="source-topic"><summary>Источники подробных разборов</summary>
            <SourceCatalogList entries={filterSourceCatalog(entries, (usage) => usage.topic === topic && Boolean(usage.cardId))} />
          </details>
        </section>;
      })}
    </section>
    <section id="classification-sources"><h2>Православная классификация</h2>{Object.entries(classifications).map(([id, entry]) => <article><h3>{namesById.get(id)}</h3><p>{entry.label}. {entry.text}</p><p>{entry.authority}: <a href={entry.url}>{entry.title}</a>.</p></article>)}</section>
    <section id="relations-documents"><h2>Документы об отношениях между традициями</h2><p>Ниже — датированные документы их авторов. Их исторические оценки не заменяют православного вероучения и не переносятся автоматически на всех современных последователей.</p>{[...views].sort((a,b) => Number(b.id === 'orthodoxy') - Number(a.id === 'orthodoxy')).map(view => <details class="source-topic"><summary>{namesById.get(view.id)}</summary>{view.data.documents.map(doc => <ViewTile author={view.id} doc={doc} order={traditions.map(entry => entry.id)} namesById={namesById} colorById={colorById} />)}</details>)}</section>

    <section id="adherents">
      <h2>Численность: даты и способы подсчёта</h2>
      <p>На страницах показаны округлённые оценки. Годы и способы подсчёта различаются: членство в организации не всегда означает то же, что религиозная самоидентификация.</p>
      {traditions.map(({ data }) => <article>
        <h3>{data.adherents.display === false ? 'Восточные и Древневосточные православные церкви вместе (категория Pew)' : data.name}: {data.adherents.display === false ? '≈ 260 млн' : data.adherents.value} ({data.adherents.year})</h3>
        <p>{data.adherents.method}</p>
        <ul>{data.adherents.proof.map((proof) => <li><a href={proof.url}>{proof.title}</a></li>)}</ul>
      </article>)}
    </section>

    <section id="map-method">
      <h2>Карта религиозной принадлежности</h2>
      <p>Оценки за 2020 год, опубликованы Pew в 2025 году; таблица дополнена в 2026 году. Это религиозная принадлежность, а не измерение личной веры. Округлённые доли могут не давать ровно 100 %.</p>
      <p>Границы и названия не выражают позиции о статусе территорий; подложка и единицы статистики могут различаться.</p>
      <p><a href={countries.url}>Pew Research Center — состав населения 201 страны и территории</a>. Подложка: Natural Earth.</p>
      <p>Деление христиан на католиков, протестантов, православных и других: <a href={christianTraditions.url}>Pew Research Center, «Global Christianity» (2011), таблица «Christian Traditions by Region and Country»</a>, оценка на 2010 год. Доля традиции внутри христиан страны из этой таблицы применена к числу христиан 2020 года; оценки Pew округлены, значения «&lt; N» взяты как N/2. Это расчёт сайта, а не опубликованная Pew оценка на 2020 год. Для Макао использована строка Macau, для Кюрасао — строка бывших Нидерландских Антильских островов.</p>
    </section>
    <section id="history-evidence">
      <h2>Археологические свидетельства</h2>
      <p>{history.find((chapter) => chapter.id === 'evidence')!.text}</p>
    </section>
    <CreationTraditions />
    <WorldComposition />
    <WorldMethodology />
    <section id="overview-notes"><h2>Авраамические религии: пояснения к группировке</h2><p>{overview.introduction.text}</p>{overview.groups.map((group) => <article><h3>{group.title}</h3><p>{group.text}</p></article>)}</section>
    <section id="legal-context"><h2>Правовая справка</h2><p>{JW_NOTE_TEXT}</p></section>

    <section id="by-tradition">
      <h2>Источники по традициям и темам</h2>
      {
        traditions.map((tradition) => {
          const traditionEntries = byTradition.get(tradition.id) ?? [];
          return (
            traditionEntries.length > 0 && (
              <div class="tradition-group" id={tradition.id}>
                <h3>
                  <span class="chip" style={`background:var(${colorById.get(tradition.id) ?? '--t-other'})`} aria-hidden="true" />
                  {tradition.data.name}
                </h3>
                {[
                  { title: 'Общие сведения и отношения с другими', topic: null },
                  ...TOPIC_ORDER.map((topic) => ({ title: TOPIC_TITLES_RU[topic], topic })),
                ].map(({ title, topic }) => {
                  const topicEntries = filterSourceCatalog(traditionEntries, (usage) => topic ? usage.topic === topic : !usage.topic);
                  return topicEntries.length > 0 && <details class="source-topic"><summary>{title} · {topicEntries.length}</summary>
                    <SourceCatalogList entries={topicEntries} />
                  </details>;
                })}

              </div>
            )
          );
        })
      }
    </section>

    <section id="pair-reference">
      <h2>Подробные материалы: православие и Свидетели Иеговы</h2>
      <details class="source-topic" id="pair-refs">
        <summary>Библиография сравнения</summary>
        <Fragment set:html={pairSections.refs} />
      </details>
      <details class="source-topic" id="pair-voices">
        <summary>Именные цитаты из исходного исследования</summary>
        <p>Эти свидетельства приводятся с именами авторов и указанием перевода. Авторское духовное размышление не является отдельным догматическим определением.</p>
        <Fragment set:html={(pairSections.summary.split('<h3 class="qhead">')[1] ?? '').replace(/^Голоса двух традиций<\/h3>/, '').replace(/href="#correction-([^"]+)"/g, 'href="#pair-correction-$1"')} />
      </details>
      <details class="source-topic" id="pair-corrections">
        <summary>Уточнения и источники</summary>
        <ol>{pairCorrections.map((correction) => <li id={`pair-correction-${correction.id}`}>
          <p><strong>{correction.replace}</strong></p>
          <p>{correction.reason}</p>
          <ul>{[...new Map(correction.proof.map((proof) => [proof.url, proof])).values()].map((proof) => <li>
            <a href={proof.url}>{proof.title}</a><span class="meta"> · {proof.accessed}</span>
          </li>)}</ul>
        </li>)}</ol>
      </details>
      <p>Библейские аргументы исходного исследования переработаны и включены в соответствующие темы. Исходный документ и его прежние исправления сохранены в репозитории для проверки происхождения материала. <a href={withBase('pairs/orthodoxy-jw/')}>Открыть сравнение</a>.</p>
    </section>

    <section id="coverage">
      <h2>Покрытие</h2>
      {
        coverageByTradition.length > 0 ? (
          <table class="coverage">
            <caption>Темы сравнения: по традиции (из {TOPIC_ORDER.length} тем)</caption>
            <thead>
              <tr>
                <th scope="col">Традиция</th>
                <th scope="col">Подтверждено</th>
                <th scope="col">Уточняется</th>
              </tr>
            </thead>
            <tbody>
              {coverageByTradition.map((row) => (
                <tr>
                  <th scope="row">
                    <span class="chip" style={`background:var(${colorById.get(row.id) ?? '--t-other'})`} aria-hidden="true" />
                    {row.name}
                  </th>
                  <td>{row.verified} / {row.total}</td>
                  <td>{row.todo} / {row.total}</td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <p class="empty">Данные ещё готовятся.</p>
        )
      }
      {
        coverageByTradition.length > 0 && (
          <table class="coverage">
            <caption>Темы сравнения: среди готовых традиций</caption>
            <thead>
              <tr>
                <th scope="col">Тема</th>
                <th scope="col">Подтверждено</th>
                <th scope="col">Уточняется</th>
              </tr>
            </thead>
            <tbody>
              {coverageByTopic.map((row) => (
                <tr>
                  <th scope="row">{row.title}</th>
                  <td>{row.verified}</td>
                  <td>{row.todo}</td>
                </tr>
              ))}
            </tbody>
          </table>
        )
      }
      <table class="coverage" data-analysis-coverage>
        <caption>Карточки подробных разборов</caption>
        <thead><tr><th scope="col">Традиция</th><th scope="col">Подтверждено</th><th scope="col">Уточняется</th></tr></thead>
        <tbody>{analysisCoverage.map((row) => <tr data-tradition={row.id}>
          <th scope="row">{row.name}</th><td>{row.verified} / {row.total}</td><td>{row.todo} / {row.total}</td>
        </tr>)}</tbody>
      </table>
    </section>


    <section id="texts">
      <h2>Цитируемые тексты и переводы</h2>
      <ul>{textSources.map((item) => <li><a href={item.url}>{item.title}</a></li>)}</ul>
      <details class="source-topic" id="further-reading">
        <summary>Дополнительное чтение к подробным разборам</summary>
        <p>Рекомендованные материалы перечислены отдельно от проверочных выдержек.</p>
        <ul>{furtherReading.map((item) => <li>
          <a href={item.url}>{item.author ? `${item.author}. ` : ''}{item.title}</a> — {READING_KIND_LABELS[item.kind]}.
          <span class="meta"> {namesById.get(item.tradition)}: <a href={profileHref(item.tradition, item.cardId)}>{item.cardTitle}</a></span>
        </li>)}</ul>
      </details>
    </section>

    <section id="data-and-media">
      <h2>Данные карты и фотографии</h2>
      <p>Статистика: <a href="https://www.pewresearch.org/religion/feature/religious-composition-by-country-2010-2020/">Pew — Religious Composition by Country, 2010–2020</a> (201 страна и территория; обращение 2026-09-26).</p>
      <p>Географическая подложка: <a href="https://www.naturalearthdata.com/downloads/110m-cultural-vectors/110m-admin-0-countries/">Natural Earth, 1:110m</a>, <a href="https://www.naturalearthdata.com/about/terms-of-use/">public domain</a>. Подписи и границы схематические.</p>
      <ul>{media.map((item) => <li id={`media-${item.id}`}>{item.source.startsWith('http') ? <a href={item.source}>{item.caption}</a> : <>{item.caption} ({item.source})</>} — {item.author}, <a href={item.licenseUrl}>{item.license}</a> (обращение {item.accessed}). {item.changes === 'No edits; Wikimedia thumbnail.' ? 'Без изменений; уменьшенная копия Wikimedia.' : item.changes}</li>)}</ul>
    </section>


  </main>
</Base>

<script>
  const revealSource = () => {
    const target = document.getElementById(location.hash.slice(1));
    if (!target) return;
    for (let node: HTMLElement | null = target; node; node = node.parentElement) {
      if (node instanceof HTMLDetailsElement) node.open = true;
    }
    requestAnimationFrame(() => target.scrollIntoView());
  };
  window.addEventListener('hashchange', revealSource);
  if (location.hash) revealSource();
</script>

<style>
  .page {
    max-width: var(--page);
    margin: 0 auto;
    padding: 48px 24px 64px;
    display: grid;
    gap: 48px;
  }

