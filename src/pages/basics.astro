---
import { formatAccessed } from '../lib/citations';
import { innerQuotes, langOf } from '../lib/typography';
// «С чего начать» (docs/tasks/site-m34-newcomer-reading.md, outcome 4): the
// basics a reader without religious education needs before the comparison.
import { getCollection } from 'astro:content';
import SectionPage from '../layouts/SectionPage.astro';
import TraditionImage from '../components/TraditionImage.astro';
import LineageTree from '../components/LineageTree.astro';
import { withBase } from '../lib/paths';

const sections = (await getCollection('basics')).sort((a, b) => a.data.order - b.data.order);
// The seven Sacraments as the catechism lists them (§282; glossary «Таинство»),
// so the section that names only two still shows all seven (site audit V2-15).
const SACRAMENTS = ['Крещение', 'Миропомазание', 'Причащение (Евхаристия)', 'Покаяние', 'Священство', 'Брак', 'Елеосвящение'];
---
<SectionPage title="С чего начать: христианство коротко" lead="Самое необходимое, чтобы читать сайт без подготовки. Пять минут чтения; трудные слова объясняются по нажатию и в словаре.">
  <nav class="basics-contents" aria-label="Содержание">
    <ol>{sections.map((section) => <li><a href={`#${section.id}`}>{section.data.title}</a></li>)}</ol>
  </nav>
  {sections.map((section) => <section id={section.id} class="basics-section" aria-labelledby={`${section.id}-title`}>
    <h2 id={`${section.id}-title`}><span class="step">{section.data.order}</span> {section.data.title}</h2>
    {section.id === 'christ-and-christians' && <TraditionImage id="orthodoxy" compact />}
    {section.data.points.map((point) => <p>{point}</p>)}
    {section.id === 'divisions' && <LineageTree />}
    {section.id === 'church-and-sacraments' && <ol class="sacraments" aria-label="Семь Таинств">{SACRAMENTS.map((name) => <li>{name}</li>)}</ol>}
    {section.data.next.length > 0 && <p class="next">{section.data.next.map((link, index) => <>{index > 0 && ' · '}<a href={withBase(link.href)} data-carry-selection>{link.label} →</a></>)}</p>}
    <details class="proof">
      <summary>Источники</summary>
      <ul>{section.data.proof.map((source) => <li>
        <a href={source.url} target="_blank" rel="noopener noreferrer" lang={langOf(source.title)}>{source.title}</a>: <span lang={langOf(source.excerpt)}>«{innerQuotes(source.excerpt)}»</span> <span class="accessed">(дата обращения: {formatAccessed(source.accessed)})</span>
      </li>)}</ul>
    </details>
  </section>)}
</SectionPage>

<style>
  .basics-contents, .basics-section { max-width: var(--measure); }
  .sacraments { list-style: none; margin: 0 0 16px; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .sacraments li { padding: 6px 12px; border: 1px solid var(--t-orthodoxy); border-radius: 999px; font-size: 15px; }
  .basics-contents ol { margin: 0; padding-left: 22px; display: grid; gap: 6px; }
  .basics-section { scroll-margin-top: 24px; }
  .basics-section h2 { display: flex; gap: 12px; align-items: baseline; }
  .step { flex: none; display: inline-grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; border: 2px solid var(--t-orthodoxy); background: transparent; color: var(--ink); font-weight: 700; font-size: 16px; font-family: inherit; }
  .basics-section p { line-height: 1.65; font-size: 18px; }
  .next { font-size: 16px !important; }
  .proof { font-size: 15px; }
  .proof summary { cursor: pointer; color: var(--focus); font-weight: 700; }
  .proof ul { padding-left: 20px; }
  .accessed { color: var(--muted); }
  @media (max-width: 760px) {
    .basics-contents a, .next a { display: inline-flex; align-items: center; min-height: 40px; }
    .proof summary { min-height: 44px; display: list-item; padding: 10px 0; }
    .proof { overflow-wrap: anywhere; font-size: 16px; }
    .basics-section { scroll-margin-top: 72px; }
    .basics-section p { font-size: 17px; }
  }
</style>
