---
import { withBase } from '../lib/paths';
import { HOME_SECTION_TARGETS } from '../lib/homeSections';
import SectionPage from '../layouts/SectionPage.astro';
const chapters = [
  { path: 'religions/', title: 'Знакомство с религиями', text: 'Кто есть кто, что традиции говорят о себе и какие исторические связи их соединяют.' },
  { path: 'timeline/', title: 'Возникновение и развитие', text: 'Как складывались религии и движения, что происходило раньше и в какой исторической среде.' },
  { path: 'numbers/', title: 'Современный религиозный мир', text: 'Масштабы религий и внутренний состав христианства — в понятных числах.' },
  { path: 'geography/', title: 'Религии на карте', text: 'Где живут их последователи и как различается состав стран.' },
  { path: 'differences/', title: 'Сходства и основные различия', text: 'Общие корни и понятия, разные источники авторитета и разные ответы на главные вопросы.' },
  { path: 'compare/', title: 'Подробное сравнение', text: 'Учение Православной Церкви, позиция другой традиции и православный ответ — по темам.' },
];
---
<SectionPage title="Православный взгляд на религии мира" lead="От первого знакомства — к пониманию истории, связей и различий.">
  <section id="foundation" aria-labelledby="foundation-title">
    <h2 id="foundation-title">Откуда мы смотрим</h2>
    <p>Сайт исходит из истинности православной веры. Начнём с общей картины: познакомимся с религиями, увидим их исторические связи, сходства и различия. Затем перейдём к вопросам, которые требуют внимательного разбора.</p>
    <p>Православное учение служит основанием сравнения. Другие традиции представлены по их собственным источникам; православная оценка дана отдельно. <a href={withBase('reading/')} data-carry-selection>Как устроен разбор</a>.</p>
    <a class="start" href={withBase('religions/')} data-carry-selection>Начать знакомство →</a>
  </section>
  <section aria-labelledby="chapters-title"><h2 id="chapters-title">Маршрут чтения</h2>
    <ol class="chapters">{chapters.map((chapter) => <li><a href={withBase(chapter.path)} data-carry-selection>{chapter.title}</a><p>{chapter.text}</p></li>)}</ol>
  </section>
  <p class="direct">Уже есть конкретный вопрос? <a href={withBase('search/')} data-carry-selection>Найти разбор</a>. Основание для углублённого чтения — <a href={withBase('orthodoxy/')} data-carry-selection>православное учение по темам</a>.</p>
  {Object.entries(HOME_SECTION_TARGETS).map(([id, target]) => <p id={id} class="legacy-target">Раздел перенесён: <a href={withBase(target)} data-carry-selection>открыть на отдельной странице →</a></p>)}
</SectionPage>
<script>
  import { HOME_SECTION_TARGETS } from '../lib/homeSections';
  import { withBase } from '../lib/paths';
  const followSection = () => {
    const target = HOME_SECTION_TARGETS[location.hash.slice(1)];
    if (!target) return;
    const url = new URL(withBase(target), location.origin);
    url.search = location.search;
    location.replace(url.href);
  };
  followSection();
  addEventListener('hashchange', followSection);
</script>
<style>
  #foundation { max-width: 78ch; border-left: 4px solid var(--t-orthodoxy); padding-left: 24px; }
  .start { display: inline-flex; min-height: 48px; align-items: center; padding: 8px 20px; border: 1px solid var(--focus); border-radius: 8px; margin-top: 8px; font-weight: 700; }
  .chapters { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 28px; padding: 0; list-style: none; counter-reset: chapter; }
  .chapters li { counter-increment: chapter; padding: 18px; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; }
  .chapters a { font-size: 20px; font-weight: 700; text-underline-offset: 4px; }
  .chapters a::before { content: counter(chapter) '. '; color: var(--muted); }
  .chapters p { margin: 10px 0 0; font-size: 16px; color: var(--muted); }
  .direct { max-width: 78ch; }
  .legacy-target { display: none; } .legacy-target:target { display: block; }
  @media (max-width: 760px) { .chapters { grid-template-columns: minmax(0, 1fr); } #foundation { padding-left: 16px; } }
</style>
