---
import BibleCanon from '../components/BibleCanon.astro';
import BibleFormation from '../components/BibleFormation.astro';
import SectionPage from '../layouts/SectionPage.astro';
import { getOrderedMatrix } from '../lib/content';

const traditions = await getOrderedMatrix();
---

<SectionPage
  title="Священное Писание и религиозные тексты"
  lead="Библия в Священном Предании Церкви: состав, сохранение текста, канон и переводы. Религиозные тексты других традиций рассмотрены отдельно."
>
  <BibleFormation traditions={traditions}>
    <BibleCanon />
  </BibleFormation>
</SectionPage>
