---
import BibleCanon from '../components/BibleCanon.astro';
import BibleFormation from '../components/BibleFormation.astro';
import BibleTraditions from '../components/BibleTraditions.astro';
import SectionPage from '../layouts/SectionPage.astro';
import { getOrderedMatrix } from '../lib/content';

const traditions = await getOrderedMatrix();
---

<SectionPage
  title="Писания: тексты, каноны и переводы"
  lead="Танах, Библия, Коран и другие священные тексты: что признают разные традиции, какие переводы используют и как толкуют Писание. История формирования и сравнение канонов ниже посвящены Библии."
  jwNote
>
  <BibleFormation />
  <BibleCanon traditions={traditions} />
  <BibleTraditions traditions={traditions} />
</SectionPage>
