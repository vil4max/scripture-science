---
import SiteHeader from '../components/SiteHeader.astro';
import TermHints from '../components/TermHints.astro';

interface Props {
  title: string;
  description?: string;
  // A retired address that forwards elsewhere: not indexed, canonical is the
  // destination (site audit S3-20).
  canonical?: string;
  noindex?: boolean;
}

const { title, description, canonical, noindex = false } = Astro.props;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site).href;
const FONTS = 'https://fonts.googleapis.com/css2?family=PT+Serif:ital,wght@0,400;0,700;1,400&family=PT+Sans:wght@400;700&display=swap';
const pageContent = await Astro.slots.render('default');
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'Православный взгляд на религии мира' ? title : `${title} · Православный взгляд на религии мира`}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- The web fonts load without blocking the first paint; text shows in the
         fallback font until they arrive (site audit S3-16). -->
    <Fragment set:html={`<link rel="preload" as="style" href="${FONTS}" onload="this.onload=null;this.rel='stylesheet'">`} />
    <noscript><link rel="stylesheet" href={FONTS} /></noscript>
    <script is:inline>
      // Applies a stored explicit theme before first paint, so a returning
      // visitor's light/dark choice never flashes the system theme first.
      // src/components/ThemeSwitch.astro reads/writes the same key and
      // re-applies it (and its own button state) once it mounts.
      // `js` marks a page whose scripts will run, so phone contents can start
      // folded without flashing open (site audit V3-2, S3-15).
      document.documentElement.classList.add('js');
      (function () {
        try {
          var theme = localStorage.getItem('theme');
          if (theme === 'light' || theme === 'dark') {
            document.documentElement.setAttribute('data-theme', theme);
          }
        } catch (error) {
          // localStorage unavailable (private mode, disabled storage, ...) -
          // the page just renders in the system theme.
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Перейти к содержанию</a>
    <div class="shell">
      <SiteHeader />
      <div class="content" id="content" tabindex="-1">
        <Fragment set:html={pageContent} />
      </div>
    </div>
    <TermHints />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #f3f3ef;
    --surface: #ffffff;
    --ink: #1b2230;
    --muted: #5a6272;
    --line: #dcdcd4;
    /* Borders of controls: about 3:1 against the background (V3-10). */
    --control-border: #8f949c;
    /* The two Testaments on the timeline and the Bible page (V1-17). */
    --testament-old: var(--focus);
    --testament-new: light-dark(#245b94, #8bbef2);
    --focus: #7d5616;
    /* docs/tasks/site-m5-reading-polish.md W2: running text stays under
       about 70ch. */
    --measure: 70ch;
    --page: 1200px;
    /* Tradition identity colours, in age order. The set passes the dataviz
       palette validator on #ffffff (light) and #1a2029 (dark); its CVD and
       contrast warnings oblige direct text labels next to every coloured mark.
       Protestantism is a plum, not a coral (owner, 2026-10-01): the coral
       looked like Catholic pink beside it on the confession bar and the map. */
    --t-judaism: #2a78d6;
    --t-orthodoxy: #eda100;
    --t-catholicism: #e87ba4;
    --t-islam: #008300;
    --t-protestantism: #7d3c98;
    --t-lds: #0a8fb0;
    --t-adventism: #eb6834;
    --t-jw: #3d5a80;
    --t-other: #898781;
    /* One colour per religion group, used everywhere (the world table and
       bar, the map; owner, 2026-10-01): Christians a bright red (#fc0339, owner), Muslims keep
       their tradition green --t-islam, Jews keep --t-judaism blue, and the
       rest follow the rainbow (Hindus orange, folk religions yellow,
       Buddhists teal, other religions brown; violet is Protestantism's); the nonreligious stay a
       neutral grey. Red beside green is hard for some colour-blind readers:
       every segment keeps its gap, its place in the size order and a name
       in the labels, legend or table. */
    --world-christians: #fc0339;
    --world-unaffiliated: #898781;
    --world-hindus: #ee8a2e;
    --world-folk: #cfae13;
    --world-other-christians: #a39484;
    --world-buddhists: #048ea6;
    --world-other-religions: #8a5a3c;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      color-scheme: dark;
      --bg: #11151b;
      --surface: #1a2029;
      --ink: #e8e5de;
      --muted: #a3abb8;
      --line: #2c3440;
    --control-border: #5a6472;
      --control-border: #5a6472;
      --focus: #e0b766;
      --t-judaism: #3987e5;
      --t-orthodoxy: #c98500;
      --t-catholicism: #d55181;
      --t-islam: #008300;
      --t-protestantism: #b078cc;
      --t-lds: #3cb6d4;
      --t-adventism: #d95926;
      --t-jw: #9db4cf;
      --t-other: #898781;
      --world-christians: #fc0339;
      --world-unaffiliated: #898781;
      --world-hindus: #f0953c;
      --world-folk: #e3c32f;
      --world-other-christians: #a39484;
      --world-buddhists: #048ea6;
      --world-other-religions: #b5835d;
    }
  }

  :root[data-theme='dark'] {
    color-scheme: dark;
    --bg: #11151b;
    --surface: #1a2029;
    --ink: #e8e5de;
    --muted: #a3abb8;
    --line: #2c3440;
    --focus: #e0b766;
    --t-judaism: #3987e5;
    --t-orthodoxy: #c98500;
    --t-catholicism: #d55181;
    --t-islam: #008300;
    --t-protestantism: #b078cc;
    --t-lds: #3cb6d4;
    --t-adventism: #d95926;
    --t-jw: #9db4cf;
    --t-other: #898781;
    --world-christians: #fc0339;
    --world-unaffiliated: #898781;
    --world-hindus: #f0953c;
    --world-folk: #e3c32f;
    --world-other-christians: #a39484;
    --world-buddhists: #048ea6;
    --world-other-religions: #b5835d;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: 'PT Sans', -apple-system, 'Segoe UI', Arial, sans-serif;
    font-size: 18px;
    line-height: 1.55;
    -webkit-text-size-adjust: 100%;
  }

  /* The sidebar beside the page on a desktop (docs/tasks/site-m13-sidebar-sections.md);
  below 1000px it becomes a top bar. */
  @media (min-width: 1000px) {
    .shell {
      display: grid;
      grid-template-columns: 260px minmax(0, 1fr);
      min-height: 100vh;
    }
  }

  .content {
    min-width: 0;
  }

  h1,
  h2,
  h3,
  h4 {
    font-family: 'PT Serif', Georgia, serif;
    line-height: 1.2;
    text-wrap: balance;
  }

  a {
    color: inherit;
  }

  :focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  /* Hidden until a keyboard user tabs to it (site audit S3-11). */
  .skip-link { position: absolute; left: 8px; top: -60px; z-index: 100; padding: 10px 14px; border-radius: 8px; background: var(--focus); color: var(--bg); font-weight: 700; text-decoration: none; }
  .skip-link:focus { top: 8px; }
  .content:focus { outline: none; }

  @media (max-width: 760px) {
    main summary { min-height: 44px; padding-block: 10px; font-size: 16px; }
    main select, main input { min-height: 44px; font-size: 16px; }
    main button { min-height: 44px; }
  }

  /* Sticky bars never cover a focused or linked element (V3-9). */
  html { scroll-padding-top: calc(var(--bar-h, 0px) + 16px); }

  @media print {
    .site-side, .skip-link, .qc-bar, .views, .qc-toc, .reading-toc, .back-to-top, .fold-controls, .menu-fab, .term-hint-pop { display: none !important; }
    :root { --bg: #fff; --surface: #fff; --ink: #000; }
    .shell { display: block; }
    * { position: static !important; box-shadow: none !important; }
  }

  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }
</style>
