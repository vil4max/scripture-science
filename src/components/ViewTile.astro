---
import SourceLink from './SourceLink.astro';
import ProofLink from './ProofLink.astro';

interface Proof {
  url: string;
  title: string;
  tier: 'official' | 'reference' | 'news';
  excerpt: string;
  accessed: string;
}

interface Props {
  author: string;
  showContext?: boolean;
  doc: {
    about: string[];
    body: string;
    date: string;
    unity: { kind: 'official' | 'partial'; note: string; proof: Proof[] };
    status_check: 'verified' | 'todo';
    summary: string;
    quote: { text: string; text_ru?: string; translation?: string; url: string };
    proof: Proof[];
    title: string;
    title_ru: string;
  };
  // Age-ordered tradition ids, names and colour tokens (EDITORIAL.md
  // principle 2: subjects stand older first).
  order: string[];
  namesById: Map<string, string>;
  colorById: Map<string, string>;
}

const { author, doc, order, namesById, showContext = true } = Astro.props;
const nameOf = (id: string) => namesById.get(id) ?? id;
const rank = new Map(order.map((id, index) => [id, index]));
const about = [...doc.about].sort((a, b) => (rank.get(a) ?? rank.size) - (rank.get(b) ?? rank.size));

// Dates are a year ("1180"), a full ISO date or a phrase ("не указана").
const year = /^(\d{1,4})(?:-\d{2}-\d{2})?$/.exec(doc.date)?.[1];
const yearLabel = year ? `${Number(year)} г.` : `дата ${doc.date}`;
const fullDate = /^\d{4}-\d{2}-\d{2}$/.test(doc.date)
  ? new Intl.DateTimeFormat('ru', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(
      new Date(`${doc.date}T00:00:00Z`),
    )
  : null;
const UNITY_LABEL = { official: 'Официальная позиция', partial: 'Позиция автора' } as const;
// Some quotes already carry their own guillemets.
const quoteText = doc.quote.text_ru ?? doc.quote.text;
const quoted = /^«[\s\S]*»$/.test(quoteText) ? quoteText : `«${quoteText}»`;
---

<article class="tile">
  {showContext && <p class="meta">{nameOf(author)} · О традициях: {about.map(nameOf).join(', ')}</p>}
  <p class={`unity ${doc.unity.kind}`}><span class="unity-label">{UNITY_LABEL[doc.unity.kind]}</span></p>
    <h4 class="title">{doc.title_ru} <span class="year">{yearLabel}</span></h4>
    <p class="meta">
      {doc.body}
      {fullDate && `, ${fullDate}`}
    </p>
  {doc.status_check === 'todo' && <p class="todo-flag">источник уточняется</p>}
  <details class="document">
    <summary>Прочитать позицию и цитату</summary>
    <p class="summary">{doc.summary}</p>
    <p class={`unity ${doc.unity.kind}`}>
      <span class="unity-label">{UNITY_LABEL[doc.unity.kind]}:</span> {doc.unity.note}
      <ProofLink proof={doc.unity.proof} exclude={[doc.quote.url, ...doc.proof.map((item) => item.url)]} inline />
    </p>
    <blockquote class="quote">
      <p>{quoted}</p>
      {doc.quote.translation && <p class="translation">{doc.quote.translation}</p>}
      <cite>
        —{' '}
        <SourceLink url={doc.quote.url} title={doc.title_ru} />
        <ProofLink proof={doc.proof} exclude={[doc.quote.url]} inline />
      </cite>
    </blockquote>
  </details>
</article>

<style>
  .tile {
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 16px 18px;
    background: var(--surface);
    display: grid;
    gap: 10px;
    align-content: start;
    min-width: 0;
  }

  .document > summary { cursor: pointer; color: var(--focus); font-weight: 700; }
  .document[open] > summary { margin-bottom: 14px; }
  .document > :not(summary) + * { margin-top: 12px; }
  .quote .translation { font-size: 13px; font-style: normal; color: var(--muted); }

  .title {
    margin: 0;
    font-family: 'PT Serif', Georgia, serif;
    font-size: 20px;
    line-height: 1.25;
  }

  .year {
    margin-left: 4px;
    font-family: 'PT Sans', -apple-system, 'Segoe UI', Arial, sans-serif;
    font-size: 15px;
    font-weight: 400;
    color: var(--muted);
    white-space: nowrap;
  }

  .meta {
    margin: 0;
    font-size: 14px;
    line-height: 1.45;
    color: var(--muted);
  }

  .unity {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }

  .unity-label {
    font-weight: 700;
    color: var(--ink);
  }

  .unity.partial .unity-label {
    color: var(--focus);
  }

  .unity :global(.proof-inline a) {
    color: var(--focus);
    text-decoration: none;
  }

  .summary {
    margin: 0;
    line-height: 1.6;
  }

  .todo-flag {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
    color: var(--focus);
  }

  .quote {
    margin: 0;
    padding: 2px 0 2px 14px;
    border-left: 3px solid color-mix(in srgb, var(--ink) 25%, transparent);
  }

  .quote p {
    margin: 0;
    font-style: italic;
    line-height: 1.6;
  }

  .quote cite {
    display: block;
    margin-top: 4px;
    font-style: normal;
    font-size: 14px;
    color: var(--muted);
  }

  .quote cite a {
    color: var(--focus);
    text-decoration: none;
  }

  .quote cite a:hover {
    text-decoration: underline;
  }
</style>
