---
import type { CollectionEntry } from 'astro:content';
interface Props {
  traditions: CollectionEntry<'matrix'>[];
  colorById: Map<string, string>;
}
import { withBase } from '../lib/paths';
const { traditions, colorById } = Astro.props;
const alphabetical = traditions.filter(tradition => tradition.id !== 'orthodoxy').sort((a, b) => a.data.name.localeCompare(b.data.name, 'ru'));
---
<div class="colhead" data-comparison-slots>
  <div class="slots">
    <div class="colcell foundation" data-foundation-column style="--slot-color:var(--t-orthodoxy)"><span>Основание сравнения</span><strong class="fixed">Православие</strong></div>
    {[1, 2].map((index) => <label class="colcell" style={`--slot-color:var(${index === 1 ? '--t-catholicism' : '--t-jw'})`}>
      <span>Для сравнения {index}</span>
      <select data-slot={index} aria-label={`Выберите традицию для колонки ${index + 1}`}>
        {alphabetical.map((tradition) => <option value={tradition.id} selected={tradition.id === (index === 1 ? 'catholicism' : 'jw')} data-color={colorById.get(tradition.id)}>{tradition.data.name}</option>)}
      </select>
      <a class="profile" data-profile-link={index} href={withBase(`traditions/${index === 1 ? 'catholicism' : 'jw'}/`)}>Страница традиции →</a>
    </label>)}
  </div>
  <noscript>По умолчанию показаны Православие, Католичество и Свидетели Иеговы. Для изменения двух сравнительных колонок включите JavaScript.</noscript>
</div>
<script>
  import { withBase } from '../lib/paths';
  import { hrefWithReadingContext } from '../lib/readingContext';
  import { onSelection, setSelection } from '../lib/selection-client';
  import { comparisonSlots, replaceComparisonSlot, SLOT_PARAM } from '../lib/comparisonSlots';
  const head = document.querySelector<HTMLElement>('[data-comparison-slots]');
  if (head) {
    let slots = ['orthodoxy', 'catholicism', 'jw'];
    const selects = [...head.querySelectorAll<HTMLSelectElement>('[data-slot]')];
    const publishHeight = () => document.documentElement.style.setProperty('--comparison-header-h', `${head.offsetHeight}px`);
    new ResizeObserver(publishHeight).observe(head);
    publishHeight();
    onSelection((ids) => {
      const url = new URL(location.href);
      slots = comparisonSlots(ids, url.searchParams.get(SLOT_PARAM));
      url.searchParams.set(SLOT_PARAM, slots.join(','));
      history.replaceState(history.state, '', url);
      if (ids.join(',') !== slots.join(',')) {
        setSelection(slots);
        return;
      }
      selects.forEach((select) => {
        const index = Number(select.dataset.slot);
        select.value = slots[index];
        for (const option of select.options) option.disabled = Boolean(option.value) && slots.some((id, i) => i !== index && id === option.value);
        const color = select.selectedOptions[0]?.dataset.color;
        select.closest<HTMLElement>('.colcell')?.style.setProperty('--slot-color', color ? `var(${color})` : 'var(--line)');
        const profile = head.querySelector<HTMLAnchorElement>(`[data-profile-link="${index}"]`);
        if (profile) profile.href = hrefWithReadingContext(withBase(`traditions/${slots[index]}/`), slots, location.href);
      });
    });
    selects.forEach((select) => select.addEventListener('change', () => {
      const index = Number(select.dataset.slot);
      slots = replaceComparisonSlot(slots, index, select.value);
      const url = new URL(location.href);
      url.searchParams.set(SLOT_PARAM, slots.join(','));
      history.replaceState(history.state, '', url);
      setSelection(slots);
    }));
  }
</script>
<style>
  .colhead { position: sticky; top: 0; z-index: 10; background: var(--bg); padding: 6px 0; border-bottom: 1px solid var(--line); }
  .slots { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; border: 1px solid var(--line); border-left: 4px solid var(--t-orthodoxy); }
  .colcell { display: grid; gap: 4px; min-width: 0; border-top: 3px solid var(--slot-color, var(--line)); padding: 6px 12px; }
  .colcell + .colcell { border-left: 1px solid var(--line); }
  .foundation { background: color-mix(in srgb, var(--t-orthodoxy) 10%, var(--surface)); }
  .colcell span { font-size: 13px; color: var(--muted); }
  .profile { font-size: 14px; }
  .fixed { display: flex; align-items: center; padding: 6px 0; font-size: 18px; min-height: 36px; }
  select { width: 100%; min-width: 0; padding: 6px 8px; font: inherit; font-size: 16px; color: var(--ink); background: var(--surface); border: 1px solid var(--line); border-radius: 8px; cursor: pointer; }
  select:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  @media (max-width: 600px) { .colhead { position: static; } .slots { grid-template-columns: minmax(0, 1fr); gap: 8px; } }
</style>
