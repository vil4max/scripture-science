---
import type { CollectionEntry } from 'astro:content';
interface Props {
  traditions: CollectionEntry<'matrix'>[];
  colorById: Map<string, string>;
}
const { traditions, colorById } = Astro.props;
const alphabetical = [...traditions].sort((a, b) => a.data.name.localeCompare(b.data.name, 'ru'));
---
<div class="colhead" data-comparison-slots>
  <div class="slots">
    {[0, 1, 2].map((index) => <label class="colcell">
      <span>Традиция {index + 1}</span>
      <select data-slot={index} aria-label={`Выберите традицию для колонки ${index + 1}`}>
        <option value="">Выберите традицию…</option>
        {alphabetical.map((tradition) => <option value={tradition.id} data-color={colorById.get(tradition.id)}>{tradition.data.name}</option>)}
      </select>
    </label>)}
  </div>
  <noscript>Для выбора колонок включите JavaScript; полная таблица доступна ниже.</noscript>
</div>
<p>Одна традиция — видны все стороны её споров. Две или три — только выбранные.</p>
<script>
  import { onSelection, setSelection } from '../lib/selection-client';
  import { comparisonSlots, replaceComparisonSlot, SLOT_PARAM } from '../lib/comparisonSlots';
  const head = document.querySelector<HTMLElement>('[data-comparison-slots]');
  if (head) {
    let slots = ['', '', ''];
    const selects = [...head.querySelectorAll<HTMLSelectElement>('[data-slot]')];
    const publishHeight = () => document.documentElement.style.setProperty('--comparison-header-h', `${head.offsetHeight}px`);
    new ResizeObserver(publishHeight).observe(head);
    publishHeight();
    onSelection((ids) => {
      const url = new URL(location.href);
      slots = comparisonSlots(ids, url.searchParams.get(SLOT_PARAM));
      url.searchParams.set(SLOT_PARAM, slots.join(','));
      // An empty shared comparison must not inherit its recipient's saved choice.
      if (!ids.length) url.searchParams.set('t', '');
      history.replaceState(history.state, '', url);
      selects.forEach((select, index) => {
        select.value = slots[index];
        select.options[0].textContent = slots[index] ? 'Очистить колонку' : 'Выберите традицию…';
        for (const option of select.options) option.disabled = Boolean(option.value) && slots.some((id, i) => i !== index && id === option.value);
        const color = select.selectedOptions[0]?.dataset.color;
        select.closest<HTMLElement>('.colcell')?.style.setProperty('--slot-color', color ? `var(${color})` : 'var(--line)');
      });
    });
    selects.forEach((select, index) => select.addEventListener('change', () => {
      slots = replaceComparisonSlot(slots, index, select.value);
      const url = new URL(location.href);
      url.searchParams.set(SLOT_PARAM, slots.join(','));
      history.replaceState(history.state, '', url);
      setSelection(slots.filter(Boolean));
    }));
  }
</script>
<style>
  .colhead { position: sticky; top: 0; z-index: 10; background: var(--bg); padding: 12px 0; border-bottom: 1px solid var(--line); }
  .slots { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .colcell { display: grid; gap: 6px; min-width: 0; border-top: 3px solid var(--slot-color, var(--line)); padding-top: 8px; }
  .colcell span { font-size: 13px; color: var(--muted); }
  select { width: 100%; min-width: 0; padding: 12px 8px; font: inherit; font-size: 16px; color: var(--ink); background: var(--surface); border: 1px solid var(--line); border-radius: 8px; cursor: pointer; }
  select:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  @media (max-width: 600px) { .colhead { position: static; } .slots { grid-template-columns: minmax(0, 1fr); gap: 8px; } }
  p { margin: 10px 0 0; color: var(--muted); font-size: 13px; }
</style>
