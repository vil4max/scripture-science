---
import { citationTitle, type Citations } from '../lib/citations';
interface Props { registry: Citations; }
const { registry } = Astro.props;
const tiers = { official: 'официальный источник', reference: 'справочный источник', news: 'СМИ/НКО' };
---
{registry.entries.length > 0 && <section class="page-sources" aria-labelledby="page-sources-title">
  <h2 id="page-sources-title">Источники этой страницы</h2>
  <p>Номера в тексте ведут к источникам. Здесь собраны также источники скрытых разделов сравнения.</p>
  <ol>
    {registry.entries.map((entry) => <li id={`source-${entry.number}`}>
      <a href={entry.url} target="_blank" rel="noopener noreferrer">{citationTitle(entry.proofs)}</a>
      {entry.proofs.some((proof) => proof.excerpt) && <details>
        <summary>Выдержки и сведения об источнике</summary>
        {entry.proofs.filter((proof) => proof.excerpt).map((proof) => <p><q>{proof.excerpt}</q><br/><small>{proof.tier && tiers[proof.tier]} · обращение {proof.accessed}</small></p>)}
      </details>}
      <span class="returns">К тексту: {entry.references.map((id, index) => <a href={`#${id}`} aria-label={`Вернуться к упоминанию ${index + 1} источника ${entry.number}`}>↑{index + 1} </a>)}</span>
    </li>)}
  </ol>
</section>}
<style>
  .page-sources { max-width: var(--page); margin: 0 auto; padding: 24px 32px 48px; border-top: 1px solid var(--line); font-size: 15px; overflow-wrap: anywhere; }
  h2 { font-size: 24px; } ol { max-width: 85ch; padding-left: 2em; } li { padding: 8px 0; scroll-margin-top: 120px; } li:target { background: color-mix(in srgb, var(--focus) 10%, transparent); }
  p, .returns { color: var(--muted); } details { margin-block: 6px; } summary { cursor: pointer; } .returns { font-size: 13px; }
</style>

<script>
  const bibliography = document.querySelector('.page-sources');
  if (bibliography) {
    const updateReturns = () => {
      for (const link of bibliography.querySelectorAll<HTMLAnchorElement>('.returns a')) {
        const target = document.getElementById(link.hash.slice(1));
        link.hidden = !target || Boolean(target.closest('[hidden]'));
      }
    };
    bibliography.addEventListener('click', (event) => {
      const link = (event.target as Element).closest<HTMLAnchorElement>('.returns a');
      if (!link) return;
      let parent = document.getElementById(link.hash.slice(1))?.parentElement;
      while (parent) {
        if (parent instanceof HTMLDetailsElement) parent.open = true;
        parent = parent.parentElement;
      }
    });
    const main = document.querySelector('main');
    if (main) new MutationObserver(updateReturns).observe(main, { attributes: true, subtree: true, attributeFilter: ['hidden'] });
    updateReturns();
  }
</script>
