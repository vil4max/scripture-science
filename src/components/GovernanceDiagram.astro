---
import { getOrderedMatrix } from '../lib/content';
import ProofLink from './ProofLink.astro';
interface Props { tradition: string; }
const { tradition } = Astro.props;
const entry = (await getOrderedMatrix()).find((t) => t.id === tradition);
const position = entry?.data.positions.find((p) => p.topic === 'organisation');
const supported = ['orthodoxy','jw'].includes(tradition);
// The order of the Azbyka scheme (https://azbyka.ru/shemy/pomestnye-pravoslavnye-cerkvi.shtml, 2026-10-01).
const LOCAL_CHURCHES = [
  'Константинопольская', 'Александрийская', 'Антиохийская', 'Иерусалимская', 'Русская', 'Грузинская', 'Сербская', 'Румынская',
  'Болгарская', 'Кипрская', 'Элладская (Греческая)', 'Албанская', 'Польская', 'Чешских земель и Словакии', 'Православная Церковь в Америке',
  'Македонская (с 2022 г.)',
];
---
{supported && position && <figure class="governance">
  <figcaption><strong>Как устроено управление</strong><span>Упрощённая схема; подробности и оговорки — в теме «Организация» ниже.</span></figcaption>
  {tradition === 'orthodoxy' ? <>
    <p class="principle">Самостоятельное управление Поместных Церквей</p>
    <ol class="churches numbered">{LOCAL_CHURCHES.map((name) => <li>{name}</li>)}</ol>
    <p class="note">Все Поместные Церкви по схеме «<a href="https://azbyka.ru/shemy/pomestnye-pravoslavnye-cerkvi.shtml" target="_blank" rel="noopener noreferrer">Поместные Православные Церкви</a>» («Азбука веры», в порядке схемы): их 16, из них 15 — до 2022 года, когда к ним добавилась Македонская Церковь. Нет общей иерархии административного руководства.</p>
    <div class="council"><strong>Вселенский Собор</strong><br/>Может действовать от имени всей Церкви — согласно катехизису. Это не постоянно действующий центральный офис.</div>
  </> : <>
    <div class="council"><strong>Руководящий совет</strong><br/>Руководство деятельностью во всём мире</div>
    <p class="connector" aria-hidden="true">↓</p>
    <ul class="churches">{[1,2,3].map(() => <li><strong>Собрание</strong><br/>Совет старейшин</li>)}</ul>
    <p class="note">Показаны всемирное руководство и местные собрания; промежуточные уровни опущены.</p>
  </>}
  <ProofLink proof={[...position.proof, ...position.unity.proof]}/>
</figure>}
<style>
  .governance { max-width: 880px; margin: 0; padding: 24px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
  figcaption strong { font-family: 'PT Serif',serif; font-size: 24px; } figcaption span { display: block; font-size: 14px; color: var(--muted); margin-top: 8px; }
  .principle { text-align: center; font-weight: 700; } .churches { list-style: none; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .churches.numbered { counter-reset: church; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .churches.numbered li { counter-increment: church; padding: 12px 10px; font-size: 15px; }
  .churches.numbered li::before { content: counter(church) ". "; color: var(--muted); }
  .churches li { flex: 1 1 160px; padding: 16px; border: 1px solid var(--line); border-top: 3px solid var(--focus); border-radius: 6px; text-align: center; font-size: 16px; }
  .council { text-align: center; background: var(--bg); padding: 16px; border: 1px dashed var(--muted); border-radius: 6px; margin-top: 24px; font-size: 16px; }
  .connector { text-align: center; font-size: 28px; margin: 4px; } .note { font-size: 14px; color: var(--muted); }
</style>
