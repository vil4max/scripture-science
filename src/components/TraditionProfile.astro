---
import lineageData from '../data/lineage.json';
import { profileChronology } from '../lib/profileChronology';
import { parseLineage, validateReferences, formatHistoricalYear, formatYearAd } from '../lib/timeline';
import { withBase } from '../lib/paths';
import { type CollectionEntry } from 'astro:content';
import TraditionImage from './TraditionImage.astro';
import GovernanceDiagram from './GovernanceDiagram.astro';
import { GOVERNANCE_TRADITIONS } from '../lib/governance';
import AnalysisCard from './AnalysisCard.astro';
import Dispute from './Dispute.astro';
import OrthodoxAssessment from './OrthodoxAssessment.astro';
import OrthodoxClassification from './OrthodoxClassification.astro';
import { disputeView } from '../lib/disputes';
import MatrixPosition from './MatrixPosition.astro';
import SectionPage from '../layouts/SectionPage.astro';
import { getDisputes, getOrderedMatrix } from '../lib/content';
import { getAnalyses } from '../lib/analysis';
import { JW_NOTE_ID } from '../lib/jwNote';
import { getFamilyByTradition } from '../lib/families';
import { sinceLines, TOPIC_ORDER, TOPIC_GROUPS, TOPIC_INTROS, TOPIC_TITLES_RU, TRADITION_COLOR_TOKEN } from '../lib/rules';

// One tradition's own page: Orthodoxy's at /orthodoxy/ («Православная вера»,
// the site's foundation), every other at /traditions/<id>/ (owner, 2026-10-01).
interface Props {
  tradition: CollectionEntry<'matrix'>;
  title?: string;
}

const { tradition, title } = Astro.props;
const { name, full_name, since, adherents, scripture } = tradition.data;
// Curated analysis cards replace the topic-by-topic positions
// (docs/tasks/site-m33-jw-analysis.md).
const curated = (await getAnalyses()).find((entry) => entry.data.tradition === tradition.id)?.data;
const cards = curated?.groups.flatMap((group) => group.cards) ?? [];
const family = getFamilyByTradition(tradition.id);
const color = TRADITION_COLOR_TOKEN[tradition.data.id];
const traditions = await getOrderedMatrix();
const order = traditions.map((entry) => entry.id);
const namesById = new Map(traditions.map((entry) => [entry.id, entry.data.name]));
const colorById = new Map(traditions.map((entry) => [entry.id, TRADITION_COLOR_TOKEN[entry.data.id]]));
const disputes = (await getDisputes()).filter((entry) => disputeView({
  challengers: entry.data.challenges.map((part) => part.tradition),
  answerers: entry.data.answers.map((part) => part.tradition),
}, [tradition.id]).visible);
const lineage = parseLineage(lineageData);
validateReferences(lineage);
const chronology = profileChronology(lineage, tradition.data.id);
const selfView = lineage.selfViews.find((view) => view.tradition === tradition.id);
const associationLabels = {
  own: '', ancestor: 'Общая предыстория', union: 'Уния', epoch: 'Собственная хронология традиции',
};
// The legal note belongs to the Jehovah's Witnesses page only (owner, 2026-10-01).
const showsJwNote = tradition.id === 'jw';

---

<SectionPage title={title ?? name} lead={full_name === name ? undefined : full_name} jwNote={showsJwNote}>
  <dl slot="header-details" class="profile-facts" style={`--tradition-color: var(${color})`}>
    {family && (
      <div>
        <dt>Классификация</dt>
        <dd>
          <OrthodoxClassification tradition={tradition.id} />
        </dd>
      </div>
    )}
    <div>
      <dt>Возникновение</dt>
      <dd>
        {sinceLines(since.label).map((line) => <p>{line}</p>)}
      </dd>
    </div>
    <div>
      <dt>Численность</dt>
      <dd>
        <p>{adherents.value} ({adherents.year})</p>
        <p class="note">{adherents.scopeNote ?? adherents.method}</p>
      </dd>
    </div>
    <div>
      <dt>Писание</dt>
      <dd>
        <p>{scripture.overview?.text ?? scripture.name}</p>
      </dd>
    </div>
  </dl>
  <TraditionImage id={tradition.id === 'orthodoxy' ? 'orthodoxy-all-saints' : tradition.id} />
  <section class="profile-section" aria-labelledby="chronology-title">
    <h2 id="chronology-title">Хронология</h2>
    {selfView && <aside data-no-terms>
      <h3>Как традиция понимает своё происхождение</h3>
      <p>{selfView.summary}</p>
      {(selfView.gaps ?? []).map((gap) => <p>Разрыв {formatHistoricalYear(gap.from)}–{formatHistoricalYear(gap.to)}: {gap.label}.</p>)}
    </aside>}
    <p class="chronology-key">Ранние события — от Сотворения мира (от С. М.) по византийской эре; с первого года христианского летосчисления — от Рождества Христова (от Р. Х.). В скобках — тот же год в привычном счёте до Рождества Христова. Для дат без месяца принят отсчёт января–августа.</p>
    <ol class="chronology">
      {chronology.map((row) => (
        <li data-chronology-id={row.id}>
          <p class="chronology-date">{row.approx && 'ок. '}{formatHistoricalYear(row.year)}{row.year < 0 && <span class="ad-gloss"> ({row.approx && 'ок. '}{formatYearAd(row.year)})</span>}</p>
          {associationLabels[row.association] && <p class="association">{associationLabels[row.association]}</p>}
          <p><strong>{row.title}</strong>{row.text && ` — ${row.text}`}{row.todo && <span class="association"> (уточняется)</span>}</p>
        </li>
      ))}
    </ol>
    <a href={withBase('timeline/')}>Открыть общую хронологию</a>
  </section>
  {curated ? (
  <section class="positions curated" aria-labelledby="positions-title">
    <h2 id="positions-title">Вера и практика: подробный разбор</h2>
    <p class="analysis-lead">{curated.lead} <a href={withBase('reading/')} data-carry-selection>Как различать учение, объяснение автора и оценку</a>.</p>
    <p class="analysis-authority">{curated.authorityNote}{tradition.id === 'jw' && <sup><a href={`#${JW_NOTE_ID}`}>*</a></sup>}</p>
    <section class="key-points" aria-labelledby="key-points-title">
      <h3 id="key-points-title">Главное</h3>
      <p class="key-points-lead">Основные отличия от православного учения. Каждый пункт ведёт к подробному разбору.</p>
      <ol>{curated.keyPoints.map((point) => <li><a href={`#${point.card}`}>{point.text}</a></li>)}</ol>
    </section>
    <div class="reading-layout">
    <details class="reading-toc" open>
    <summary>Содержание разбора</summary>
    <nav class="analysis-contents" aria-label="Содержание разбора">
      <p class="contents-label">В этом разборе</p>
      <p class="reading-progress" aria-live="off">Вопросов: {cards.length}</p>
      <ol>
        {curated.groups.map((group) => <li>
          <a href={`#${group.id}`}>{group.title}</a>
          <ul>{group.cards.map((card) => <li><a href={`#${card.id}`}>{card.title}</a></li>)}</ul>
        </li>)}
      </ol>
    </nav>
    </details>
    <div class="reading-body">
    <p class="fold-controls">
      <span>Все вопросы — коротко; подробности раскрываются по нажатию.</span>
      <button type="button" class="fold-toggle" aria-pressed="false" hidden>Раскрыть все</button>
    </p>
    {curated.groups.map((group) => <section class="analysis-group" id={group.id}>
      <h3>{group.title}</h3>
      {group.cards.map((card) => <AnalysisCard card={card} tradition={tradition.id} traditionName={name} previous={cards[cards.indexOf(card) - 1]} next={cards[cards.indexOf(card) + 1]} />)}
    </section>)}
    {disputes.length > 0 && <section class="analysis-group" id="questions">
      <h3>Спорные вопросы в сопоставлении с другими традициями</h3>
      {disputes.map((dispute) => <Dispute dispute={dispute} order={['orthodoxy', tradition.id]} namesById={namesById} colorById={colorById} />)}
    </section>}
    </div>
    </div>
  </section>
  ) : (
  <section class="positions" aria-labelledby="positions-title">
    <h2 id="positions-title">{tradition.id === 'orthodoxy' ? 'Православное учение по темам' : 'Вера и практика: православное сопоставление'}</h2>
    {TOPIC_ORDER.map((topicId) => {
      const position = tradition.data.positions.find((item) => item.topic === topicId);
      if (!position) throw new Error(`Missing profile position: ${tradition.id}/${topicId}`);
      return (
        <>
        {TOPIC_GROUPS.filter((group) => group.topics[0] === topicId).map((group) => <h3>{group.title}</h3>)}
        <section class="topic" aria-labelledby={`topic-${topicId}`}>

          <h4 id={`topic-${topicId}`}>{TOPIC_TITLES_RU[topicId]}</h4>
            {TOPIC_INTROS[topicId] && <p class="topic-intro">{TOPIC_INTROS[topicId]}</p>}
          {tradition.id !== 'orthodoxy' && <><h5>Православное учение</h5><p>{traditions.find(entry => entry.id === 'orthodoxy')?.data.positions.find(item => item.topic === topicId)?.summary}</p><h5>Учение традиции</h5></>}
          <MatrixPosition position={position} tradition={tradition.id} expandable />
          <OrthodoxAssessment tradition={tradition.id} topic={topicId} />
          {disputes.filter(dispute => dispute.data.topic === topicId).map(dispute => <Dispute dispute={dispute} order={tradition.id === 'orthodoxy' ? ['orthodoxy', ...order.filter(id => id !== 'orthodoxy')] : ['orthodoxy', tradition.id]} namesById={namesById} colorById={colorById} />)}
        </section>
        </>
      );
    })}
  </section>
  )}
  {GOVERNANCE_TRADITIONS.includes(tradition.id) && <section id="governance" class="profile-section"><h2>Церковное устройство и практика</h2><GovernanceDiagram tradition={tradition.id} /></section>}
  <section id="sources-and-relations" class="profile-section"><h2>Источники и отношения с другими</h2><p>Православные ответы даны рядом с соответствующими убеждениями. <a href={withBase(`sources/#${tradition.id}`)}>Документы и источники этой традиции</a> и <a href={withBase('sources/#relations-documents')}>взаимные оценки в исторических документах</a> собраны в справочном разделе.</p></section>

</SectionPage>

<style>
  .analysis-lead, .analysis-authority { max-width: var(--measure); }
  .key-points { max-width: var(--measure); margin: 8px 0 32px; padding: 16px 20px; border: 1px solid var(--line); border-left: 4px solid var(--t-orthodoxy); border-radius: 6px; background: var(--surface); }
  .key-points h3 { margin: 0 0 4px; }
  .key-points-lead { margin: 0 0 12px; color: var(--muted); font-size: 15px; }
  .key-points ol { margin: 0; padding-left: 22px; display: grid; gap: 8px; }
  .key-points li { line-height: 1.5; }
  .key-points a { color: inherit; text-decoration-color: var(--line); text-underline-offset: 3px; }
  .key-points a:hover { text-decoration-color: currentColor; }
  .fold-controls { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; justify-content: space-between; margin: 0 0 8px; color: var(--muted); font-size: 14px; }
  .fold-toggle { font: inherit; font-weight: 700; color: var(--focus); background: none; border: 1px solid var(--line); border-radius: 4px; padding: 6px 12px; cursor: pointer; min-height: 36px; }
  .analysis-authority { color: var(--muted); }
  .positions.curated { max-width: none; }
  .reading-layout { display: grid; grid-template-columns: minmax(0, 1fr) 220px; gap: 32px; align-items: start; }
  .reading-body { grid-column: 1; grid-row: 1; min-width: 0; }
  .reading-toc { grid-column: 2; grid-row: 1; position: sticky; top: 16px; max-height: calc(100vh - 32px); overflow-y: auto; border-left: 1px solid var(--line); padding-left: 16px; font-size: 14px; }
  .reading-toc > summary { display: none; }
  .analysis-contents ol { margin: 0; padding: 0; list-style: none; display: grid; gap: 18px; }
  .contents-label { font-weight: 700; margin: 0; }
  .reading-progress { color: var(--muted); margin: 4px 0 16px; font-size: 13px; }
  .analysis-contents a { display: inline-block; padding: 3px 0; text-decoration: none; }
  .analysis-contents a:hover { text-decoration: underline; }
  .analysis-contents a[aria-current='location'] { color: var(--focus); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  .analysis-contents > ol > li > a { font-weight: 700; }
  .analysis-contents ul { margin: 6px 0 0; padding-left: 18px; font-size: 14px; }
  .analysis-group { scroll-margin-top: 24px; }
  .note { font-size: 14px; color: var(--muted); }
  .topic-intro { margin: 0 0 20px; color: var(--muted); font-size: 15px; max-width: 80ch; }
  .chronology {
    list-style: none;
    padding: 0;
    margin: 24px 0;
    display: grid;
    gap: 24px;
  }

  .chronology p { margin: 0 0 6px; }
  .chronology-key, .chronology-date, .association { color: var(--muted); }
  .chronology-date { font-weight: 700; }
  .association { font-size: 14px; }

  .profile-section {
    max-width: 70ch;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .view-group {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    margin-top: 24px;
  }

  .view-group h3 { margin: 0; }

  @media (max-width: 600px) {
    .profile-views :global(.route) { flex-wrap: wrap; }
    .profile-views :global(.about) { flex-basis: 100%; }
    .profile-views :global(.chip) { white-space: normal; }
  }

  .positions {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    max-width: 70ch;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .topic h4 {
    margin: 0 0 16px;
    font-size: 21px;
  }

  .profile-facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    margin: 24px 0 0;
    padding: 0 0 0 20px;
    border-left: 4px solid var(--tradition-color);
    max-width: 70ch;
    overflow-wrap: anywhere;
  }

  dt {
    margin-bottom: 6px;
    color: var(--muted);
    font-size: 14px;
  }

  dd {
    margin: 0;
    line-height: 1.6;
  }

  dd p {
    margin: 0;
  }

  @media (max-width: 760px) {
    .reading-layout { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .reading-body { grid-column: 1; grid-row: 2; }
    .reading-toc { grid-column: 1; grid-row: 1; position: sticky; top: 0; z-index: 12; max-height: 60vh; max-height: 60dvh; padding: 0; background: var(--surface); border: 1px solid var(--line); border-radius: 6px; }
    .reading-toc > summary { display: list-item; cursor: pointer; padding: 12px 16px; min-height: 48px; font-size: 16px; font-weight: 700; color: var(--focus); }
    .analysis-contents { padding: 0 16px 16px; }
    .analysis-contents a { padding: 8px 0; min-height: 40px; font-size: 16px; }
    .analysis-group, .reading-body :global(.card) { scroll-margin-top: 72px; }
    .profile-facts { padding-left: 12px; }
  }
</style>

<script>
  // On load the jump is instant, as the browser's own; a later in-page link
  // keeps the page's smooth scrolling.
  const revealQuestion = (behavior: ScrollBehavior) => {
    const target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
    const folded = target?.querySelector<HTMLDetailsElement>(':scope > details.discussion, :scope > details.card-body')
      ?? target?.closest('article.card')?.querySelector<HTMLDetailsElement>(':scope > details.card-body');
    if (folded && !folded.open) {
      folded.open = true;
      requestAnimationFrame(() => target?.scrollIntoView({ behavior }));
    }
  };
  const bodies = [...document.querySelectorAll<HTMLDetailsElement>('.reading-body details.card-body')];
  const foldToggle = document.querySelector<HTMLButtonElement>('.fold-toggle');
  if (foldToggle && bodies.length > 0) {
    const sync = () => {
      const allOpen = bodies.every((body) => body.open);
      foldToggle.textContent = allOpen ? 'Свернуть все' : 'Раскрыть все';
      foldToggle.setAttribute('aria-pressed', String(allOpen));
    };
    foldToggle.hidden = false;
    foldToggle.addEventListener('click', () => {
      const open = !bodies.every((body) => body.open);
      bodies.forEach((body) => { body.open = open; });
      sync();
    });
    bodies.forEach((body) => body.addEventListener('toggle', sync));
    sync();
  }
  window.addEventListener('hashchange', () => revealQuestion('smooth'));
  revealQuestion('instant');
  const contents = document.querySelector<HTMLElement>('.analysis-contents');
  const toc = document.querySelector<HTMLDetailsElement>('.reading-toc');
  const narrow = matchMedia('(max-width: 760px)');
  if (toc) {
    const resizeContents = () => { toc.open = !narrow.matches; };
    narrow.addEventListener('change', resizeContents);
    contents?.addEventListener('click', (event) => {
      if (narrow.matches && (event.target as HTMLElement).closest('a')) toc.open = false;
    });
    resizeContents();
  }
  if (contents) {
    const cards = [...document.querySelectorAll<HTMLElement>('.reading-body article.card')];
    const links = [...contents.querySelectorAll<HTMLAnchorElement>('a')];
    let current = '';
    let scheduled = false;
    const update = () => {
      scheduled = false;
      const active = cards.findLast((card) => card.getBoundingClientRect().top <= 120) ?? cards[0];
      if (!active || active.id === current) return;
      current = active.id;
      links.forEach((link) => {
        if (link.hash === `#${current}`) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      contents.querySelector('.reading-progress')!.textContent = `Вопрос ${cards.indexOf(active) + 1} из ${cards.length}`;
      const link = links.find((link) => link.hash === `#${current}`);
      if (link && toc?.open && !narrow.matches) {
        const box = toc.getBoundingClientRect();
        const item = link.getBoundingClientRect();
        if (item.top < box.top || item.bottom > box.bottom) toc.scrollTop += item.top - box.top - 60;
      }
    };
    window.addEventListener('scroll', () => {
      if (!scheduled) { scheduled = true; requestAnimationFrame(update); }
    }, { passive: true });
    update();
  }
</script>
