---
// How many people follow each religion (owner, 2026-10-01: show the world
// population, every count and every share in full). Thirteen classes are
// too many for labelled arcs, so the block is a headline figure, one
// part-to-whole bar of the world and a table whose rows carry their own
// bars; the table is also the accessible view of the bar.
import data from '../data/world-hierarchy-2026.json';
import { withBase } from '../lib/paths';

const percent = (n: number) => `${n.toFixed(1).replace('.', ',')} %`;
// Russian short counts: «2,67 млрд», «912 млн», «15,8 млн».
const count = (n: number) => n >= 1e9
  ? `${(n / 1e9).toFixed(2).replace('.', ',')} млрд`
  : `${(n / 1e6).toFixed(n >= 1e8 ? 0 : 1).replace('.', ',')} млн`;
const worldShare = (n: number) => (n / data.population) * 100;

// Segment order of the world bar, not by size: it keeps the three muted
// colours (unaffiliated, other, folk) apart. Palette validator, light and
// dark: worst adjacent CVD dE 12.3, normal-vision dE 16.1; hindus fall below
// 3:1 on the dark surface, relieved by the labelled table.
const STACK_ORDER = ['christians', 'muslims', 'unaffiliated', 'hindus', 'buddhists', 'other-religions', 'jews', 'folk'];
const stack = STACK_ORDER.map((id) => data.groups.find((group) => group.id === id)!);
// Sub-rows: Christian branches (their estimates overlap, data.method: listed,
// never summed) and the agnostics and atheists that make up the nonreligious.
const rows = [...data.groups].sort((a, b) => b.count - a.count).map((group) => ({
  ...group,
  branches: group.id === 'christians'
    ? [...data.branches].sort((a, b) => b.count - a.count)
    : (group.subgroups ?? []).map((sub) => ({ ...sub, color: group.color })),
}));
const largest = rows[0].count;
// Christian confessions under the Christian segment. Branch estimates
// overlap, so the bar shows their proportions, not disjoint counts. Order
// keeps neighbours apart (validator: light pass; dark protan dE 6.1, so
// every wide segment is labelled and the table lists all of them).
const CONFESSION_ORDER = ['orthodox', 'catholics', 'independents', 'protestants', 'unaffiliated-christians'];
const confessions = CONFESSION_ORDER.map((id) => data.branches.find((branch) => branch.id === id)!);
const christians = data.groups.find((group) => group.id === 'christians')!;
const christianWidth = (christians.count / data.population) * 100;
const describe = (label: string, n: number) => `${label}: около ${count(n)}, ${percent(worldShare(n))} населения мира`;
---
<section class="world-hierarchy" aria-labelledby="hierarchy-title">
  <h2 id="hierarchy-title">Религиозный состав населения мира, 2026 (оценка)</h2>
  <div class="headline">
    <p class="figure-label">Всё население мира, 2026 год</p>
    <p class="figure">≈ {count(data.population)} человек</p>
  </div>
  <p class="split">Как оно делится по религиям — от всего населения мира (100 %):</p>

  <div class="world-bar" role="img" aria-label="Состав населения мира по религиям, 2026 год, приблизительная оценка; числа — в таблице ниже">
    {stack.map((group) => <span class="segment" style={`flex-grow:${group.count};background:var(${group.color})`} title={describe(group.label, group.count)} data-hierarchy-id={group.id}></span>)}
  </div>
  <div class="zoom" style={`--christian-width:${christianWidth}%;--christian-color:var(${christians.color})`} aria-hidden="true"></div>
  <div class="world-bar confessions" role="img" aria-label="Христиане по конфессиям: православные, католики, независимые церкви, протестанты, вне церковных объединений; числа — в таблице ниже">
    {confessions.map((branch) => <span class="segment" style={`flex-grow:${branch.count};background:var(${branch.color})`} title={describe(branch.label, branch.count)} data-hierarchy-id={branch.id}></span>)}
  </div>
  <div class="confession-labels" aria-hidden="true">
    {confessions.map((branch) => <span style={`flex-grow:${branch.count}`}>{branch.share >= 8 && <><strong>{branch.label}</strong> ≈ {count(branch.count)}</>}</span>)}
  </div>
  <p class="confessions-title">Нижняя полоса — христиане по конфессиям, в пропорции ветвей (их оценки частично пересекаются).</p>

  <table class="counts">
    <caption class="visually-hidden">Численность последователей религий и их доля населения мира, 2026 год</caption>
    <thead><tr><th scope="col">Религия</th><th scope="col" class="bar-col"><span class="visually-hidden">Доля, наглядно</span></th><th scope="col">Численность</th><th scope="col">Доля населения мира</th></tr></thead>
    <tbody>
      {rows.map((row) => <>
        <tr data-hierarchy-id={row.id} title={describe(row.label, row.count)}>
          <th scope="row"><span class="chip" style={`background:var(${row.color})`} aria-hidden="true"></span>{row.label}</th>
          <td class="bar-col"><span class="bar" style={`width:${(row.count / largest) * 100}%;background:var(${row.color})`}></span></td>
          <td>≈ {count(row.count)}</td>
          <td>{percent(worldShare(row.count))}</td>
        </tr>
        {row.branches.map((branch) => <tr class="branch" data-hierarchy-id={branch.id} title={describe(branch.label, branch.count)}>
          <th scope="row"><span class="chip" style={`background:var(${branch.color})`} aria-hidden="true"></span>{branch.label}</th>
          <td class="bar-col"><span class="bar" style={`width:${(branch.count / largest) * 100}%;background:var(${branch.color})`}></span></td>
          <td>≈ {count(branch.count)}</td>
          <td>{percent(worldShare(branch.count))}</td>
        </tr>)}
      </>)}
    </tbody>
    <tfoot><tr><th scope="row">Население мира</th><td class="bar-col"></td><td>≈ {count(data.population)}</td><td>100 %</td></tr></tfoot>
  </table>
  <p class="note">Христианские ветви показаны внутри христиан, агностики и атеисты — внутри нерелигиозных. Оценки христианских ветвей частично пересекаются — часть людей учтена в нескольких ветвях, — поэтому сумма ветвей больше общего числа христиан. Источник: World Christian Database, Status of Global Christianity 2026; <a href={withBase('sources/#world-methodology')}>способ подсчёта</a>.</p>
</section>

<style>
  .world-hierarchy { grid-column: 1 / -1; --world-folk: #527c67; --world-independent: #3979a8; }
  h2 { margin: 0 0 16px; }
  .headline { margin-bottom: 20px; }
  .figure { margin: 4px 0 0; font-size: 40px; font-weight: 700; line-height: 1.1; }
  .figure-label { margin: 0; color: var(--muted); font-size: 16px; }
  .split { margin: 0 0 10px; }
  .world-bar { display: flex; gap: 2px; height: 28px; }
  .zoom { height: 32px; margin: 2px 0; clip-path: polygon(0 0, var(--christian-width) 0, 100% 100%, 0 100%); background: color-mix(in srgb, var(--christian-color) 45%, transparent); }
  .confessions-title { margin: 0 0 24px; font-size: 14px; color: var(--muted); }
  .confession-labels { display: flex; gap: 2px; margin: 6px 0 8px; font-size: 14px; line-height: 1.3; color: var(--muted); }
  .confession-labels span { flex-basis: 0; min-width: 0; }
  .confession-labels strong { display: block; color: var(--ink); font-weight: 700; }
  .segment { min-width: 2px; flex-basis: 0; }
  .segment:first-child { border-radius: 4px 0 0 4px; }
  .segment:last-child { border-radius: 0 4px 4px 0; }
  .counts { width: 100%; border-collapse: collapse; font-size: 16px; }
  .counts th, .counts td { padding: 7px 10px; border-bottom: 1px solid var(--line); text-align: right; font-weight: 400; white-space: nowrap; }
  .counts th[scope="row"], .counts thead th:first-child { text-align: left; }
  .counts thead th { color: var(--muted); font-size: 14px; }
  .counts tbody tr:hover { background: var(--surface); }
  .bar-col { width: 45%; }
  .counts td.bar-col { text-align: left; }
  .bar { display: block; height: 12px; min-width: 2px; border-radius: 0 4px 4px 0; }
  .chip { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 8px; }
  .counts .branch th { padding-left: 34px; color: var(--muted); }
  .counts .branch td { color: var(--muted); }
  .counts .branch .bar { height: 8px; }
  .counts tfoot th, .counts tfoot td { font-weight: 700; border-bottom: none; }
  .note { max-width: 90ch; font-size: 14px; color: var(--muted); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
