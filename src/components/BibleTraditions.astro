---
import type { CollectionEntry } from 'astro:content';
import guide from '../data/bible-guide.json';
import ProofLink from './ProofLink.astro';

interface Props { traditions: CollectionEntry<'matrix'>[]; event: string; }
const { traditions, event } = Astro.props;
const notes = guide.traditionNotes.filter((note) => note.event === event);
---

{notes.length > 0 && <aside class="tradition-notes" aria-label="В современных традициях">
  <p class="label">В современных традициях</p>
  {notes.map((note) => {
    const tradition = traditions.find((item) => item.id === note.tradition)!;
    const evidence = tradition.data.positions.filter((position) => ['scripture', 'authority'].includes(position.topic));
    return <div data-scripture-tradition={note.tradition}>
      <h4>{tradition.data.name}</h4>
      <p>{note.text}</p>
      <ProofLink proof={[...tradition.data.scripture.proof, ...evidence.flatMap((position) => [...position.proof, ...position.unity.proof])]} />
    </div>;
  })}
</aside>}

<style>
  .tradition-notes { margin-top: 22px; padding: 18px 22px; background: var(--surface); border-left: 3px solid var(--line); }
  .label { margin: 0 0 14px; font-size: 13px; color: var(--muted); }
  h4 { margin: 0 0 4px; font-size: 17px; }
  p { margin: 0; }
  .tradition-notes > div + div { margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--line); }
</style>
