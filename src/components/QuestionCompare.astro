---
// Question-first comparison (docs/tasks/site-m35-question-compare.md): each
// topic is a question in three blocks: the Orthodox teaching, the chosen
// tradition's teaching, then where they part and the Orthodox answer; only
// the analysis links and sources fold. «Этот вопрос у всех» lists every tradition's
// difference on the same question in one line each.
import { getCollection, type CollectionEntry } from 'astro:content';
import { analysisCardsForTopic, profileHref } from '../lib/analysis';
import { CREED_SOURCE, CREED_TOPICS, OTHER_TOPICS, creedArticlesFor } from '../lib/creed';
import { orthodoxAssessment } from '../lib/orthodox';
import { withBase } from '../lib/paths';
import { DEFAULT_SELECTION } from '../lib/selection';
import { positionSummaryText, TOPIC_QUESTIONS_RU, type TopicId } from '../lib/rules';

interface Props {
  traditions: CollectionEntry<'matrix'>[];
  colorById: Map<string, string>;
  // «Символ веры и различия» or «Богослужение и молитва» (owner, 2026-10-09:
  // worship and prayer have their own page, with the prayers).
  page?: 'compare' | 'worship';
  // Further entries for the contents, such as the prayer texts below.
  extraToc?: { href: string; title: string }[];
}

const { traditions, colorById, page = 'compare', extraToc = [] } = Astro.props;
const SHORT_NAMES: Record<string, string> = {
  judaism: 'Иудаизм', catholicism: 'Католичество', islam: 'Ислам', protestantism: 'Протестантизм',
  lds: 'Святые последних дней', adventism: 'Адвентисты', jw: 'Свидетели Иеговы',
};
// The chosen tradition's answer to the question, labelled as its teaching
// (owner, 2026-10-09: the answer to the question, not a self-description).
const TEACHING_LABELS: Record<string, string> = {
  judaism: 'Учение иудаизма', catholicism: 'Учение Католической Церкви', islam: 'Учение ислама',
  protestantism: 'Учение протестантов', lds: 'Учение Святых последних дней', adventism: 'Учение адвентистов',
  jw: 'Учение Свидетелей Иеговы',
};
// Full prayer texts on /worship/ that an Orthodox answer refers to.
const PRAYER_LINKS: Partial<Record<string, { id: string; title: string }[]>> = {
  services: [{ id: 'otche-nash', title: '«Отче наш»' }, { id: 'simvol-very', title: 'Символ веры' }],
  'private-prayer': [{ id: 'otche-nash', title: '«Отче наш»' }, { id: 'psalom-50', title: 'Псалом 50' }, { id: 'dostojno-est', title: '«Достойно есть»' }],
  theotokos: [{ id: 'dostojno-est', title: '«Достойно есть»' }],
  psalter: [{ id: 'psalom-50', title: 'Псалом 50' }],
};
const chosenByDefault = DEFAULT_SELECTION[1];
const orthodoxy = traditions.find((tradition) => tradition.id === 'orthodoxy')!;
const others = traditions.filter((tradition) => tradition.id !== 'orthodoxy');
const color = (id: string) => `var(${colorById.get(id) ?? '--t-other'})`;
const creedLabel = (numbers: number[]) => {
  if (numbers.length === 1) return `${numbers[0]}-й член`;
  const contiguous = numbers.every((n, i) => i === 0 || n === numbers[i - 1] + 1);
  return contiguous ? `члены ${numbers[0]}–${numbers[numbers.length - 1]}` : `члены ${numbers.join(' и ')}`;
};

type Proof = { url: string; title: string };
interface Side {
  tradition: (typeof others)[number];
  assessment?: string;
  teaching: string;
  difference: string;
  response: string;
  cards?: { title: string; href: string }[];
  proofs: Proof[];
}
interface Question {
  id: string;
  title: string;
  creed: ReturnType<typeof creedArticlesFor>;
  short: string;
  detail?: string;
  foundationHref?: string;
  sourcesHref?: string;
  sides: Side[];
}

// A comparison topic: the Orthodox position and the assessments per tradition.
const topicQuestion = async (topic: TopicId): Promise<Question> => {
  const foundation = orthodoxy.data.positions.find((position) => position.topic === topic)!;
  if (!foundation.short) throw new Error(`Orthodox position without a short answer: ${topic}`);
  const sides = await Promise.all(others.map(async (tradition) => {
    const position = tradition.data.positions.find((item) => item.topic === topic)!;
    const record = orthodoxAssessment(tradition.id, topic);
    if (!record) throw new Error(`Missing assessment: ${tradition.id}/${topic}`);
    return {
      tradition, assessment: record.id, teaching: positionSummaryText(position) ?? 'Источник уточняется.',
      difference: record.difference, response: record.response,
      cards: await analysisCardsForTopic(tradition.id, topic), proofs: [...position.proof, ...record.proof],
    };
  }));
  return {
    id: topic, title: TOPIC_QUESTIONS_RU[topic], creed: creedArticlesFor(topic), short: foundation.short,
    foundationHref: profileHref('orthodoxy', `topic-${topic}`), sourcesHref: withBase(`sources/#sources-${topic}`), sides,
  };
};
// A question outside the fifteen topics (src/data/extra-questions.yaml).
const extraQuestion = (entry: CollectionEntry<'extraQuestions'>): Question => ({
  id: entry.id, title: entry.data.question, creed: creedArticlesFor(entry.id), short: entry.data.orthodox.short, detail: entry.data.orthodox.detail,
  sides: others.map((tradition) => {
    const side = entry.data.traditions[tradition.id as keyof typeof entry.data.traditions];
    return { tradition, teaching: side.teaching, difference: side.difference, response: side.response, proofs: [...entry.data.orthodox.proof, ...side.proof] };
  }),
});

const extras = await getCollection('extraQuestions');
const extra = (id: string) => extras.filter((entry) => entry.id === id).map(extraQuestion);
// The Theotokos follows Jesus Christ: article 3 names «Марии Девы» (owner).
const creedQuestions: Question[] = [];
for (const topic of CREED_TOPICS) {
  creedQuestions.push(await topicQuestion(topic));
  if (topic === 'jesus') creedQuestions.push(...extra('theotokos'));
}
const otherQuestions = await Promise.all(OTHER_TOPICS.map(topicQuestion));
// Worship and prayer are compared on their own page (owner, 2026-10-09):
// common worship, the daily, weekly and yearly rhythm, prayer at home and the
// Psalter.
const PARTS = page === 'worship'
  ? [{ id: 'part-worship', title: 'Как служат и молятся', questions: ['services', 'schedule', 'private-prayer', 'psalter'].flatMap(extra) }]
  : [
    { id: 'part-creed', title: 'Символ веры: что говорят другие религии', questions: creedQuestions },
    { id: 'part-other', title: 'Другие различия', questions: otherQuestions },
  ];
---
<div class="qc" data-comparison data-question-compare data-view="one" data-chosen={chosenByDefault}>
  <div class="qc-bar">
    <div class="picker" role="group" aria-label="С какой религией сравнить">
      <span class="picker-label">Православие и</span>
      {others.map((tradition) => <button type="button" class="pick" data-pick={tradition.id} aria-pressed={tradition.id === chosenByDefault ? 'true' : 'false'}>
        <span class="dot" style={`background:${color(tradition.id)}`} aria-hidden="true"></span>{SHORT_NAMES[tradition.id] ?? tradition.data.name}
      </button>)}
    </div>
  </div>
  <div class="views" role="group" aria-label="Вид сравнения">
    <button type="button" class="view" data-view-button="one" aria-pressed="true">Православие и одна религия</button>
    <button type="button" class="view" data-view-button="all" aria-pressed="false">Этот вопрос у всех</button>
  </div>

  <div class="qc-layout">
    <details class="qc-toc" open>
      <summary>Вопросы</summary>
      <nav aria-label="Вопросы сравнения">
        {PARTS.map((part) => <div class="toc-group">
          <p class="toc-title"><a href={`#${part.id}`}>{part.title}</a></p>
          <ol>{part.questions.map((question) => <li><a href={`#topic-${question.id}`}>{question.title}</a></li>)}</ol>
        </div>)}
        {extraToc.map((entry) => <div class="toc-group"><p class="toc-title"><a href={entry.href}>{entry.title}</a></p></div>)}
      </nav>
    </details>

    <div class="qc-body">
      {PARTS.map((part) => <>
        <h2 class="qc-group" id={part.id}>{part.title}</h2>
        {part.questions.map((question) => <section class="question" id={`topic-${question.id}`} aria-labelledby={`question-title-${question.id}`}>
          <p class="q-meta">{question.creed.length > 0 ? `Символ веры, ${creedLabel(question.creed.map((article) => article.n))}` : part.title}</p>
          <h3 id={`question-title-${question.id}`}>{question.title}</h3>

          <div class="side orthodox" data-trad="orthodoxy" data-foundation-column>
            {question.creed.length > 0 ? <>
              <p class="who"><span class="dot" style={`background:${color('orthodoxy')}`} aria-hidden="true"></span>Символ веры</p>
              <blockquote class="creed">
                {question.creed.map((article) => <p>{question.creed.length > 1 && <span class="creed-n">{article.n}.</span>} {article.text}</p>)}
                <cite><a href={withBase('worship/#simvol-very')}>Символ веры полностью</a> · <a href={CREED_SOURCE.url} target="_blank" rel="noopener noreferrer">{CREED_SOURCE.title}</a></cite>
              </blockquote>
              <p class="thesis"><span class="plain-label">Простыми словами.</span> {question.short}</p>
              {question.detail && <p>{question.detail}</p>}
            </> : <>
              <p class="who"><span class="dot" style={`background:${color('orthodoxy')}`} aria-hidden="true"></span>Православное учение</p>
              <p class="thesis">{question.short}</p>
              {question.detail && <p>{question.detail}</p>}
            </>}
            {PRAYER_LINKS[question.id] && <p class="prayer-links">Молитвы полностью: {PRAYER_LINKS[question.id]!.map((prayer, index) => <>{index > 0 && ' · '}<a href={withBase(`worship/#${prayer.id}`)}>{prayer.title}</a></>)}</p>}
            {question.foundationHref && <p class="foundation-link"><a href={question.foundationHref} data-carry-selection>Обоснование →</a></p>}
          </div>

          {question.sides.map((side) => <div class="pair" data-trad={side.tradition.id} data-assessment={side.assessment} hidden={side.tradition.id !== chosenByDefault}>
          <div class="side tradition" style={`--accent:${color(side.tradition.id)}`}>
            <p class="who"><span class="dot" style={`background:${color(side.tradition.id)}`} aria-hidden="true"></span>{TEACHING_LABELS[side.tradition.id] ?? `Учение: ${side.tradition.data.name}`}</p>
            <p class="thesis">{side.teaching}</p>
          </div>
          <div class="side verdict">
            <p class="who"><span class="dot" style={`background:${color('orthodoxy')}`} aria-hidden="true"></span>Православный взгляд на расхождение</p>
            <p class="difference">{side.difference}</p>
            <p class="response">{side.response}</p>
            <details class="more">
              <summary>{side.cards ? 'Разбор по вопросам и источники' : 'Источники'}</summary>
              {side.cards && <p class="analysis">{side.cards.length > 0
                ? <>Разбор по вопросам: {side.cards.map((card, index) => <>{index > 0 && ' · '}<a href={card.href} data-carry-selection>{card.title}</a></>)}</>
                : <a href={profileHref(side.tradition.id)} data-carry-selection>Подробный разбор традиции →</a>}</p>}
              <p class="label">Источники</p>
              <ul class="sources">
                {side.proofs.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}</a></li>)}
              </ul>
              {question.sourcesHref && <p class="all-sources"><a href={question.sourcesHref}>Все источники по теме</a></p>}
            </details>
          </div>
          </div>)}

          <ol class="all-list" aria-label={`${question.title} — все религии`}>
            {question.sides.map((side) => <li style={`--accent:${color(side.tradition.id)}`}>
              <button type="button" class="row-pick" data-pick-row={side.tradition.id}>
                <span class="dot" style={`background:${color(side.tradition.id)}`} aria-hidden="true"></span>{SHORT_NAMES[side.tradition.id] ?? side.tradition.data.name}
              </button>
              <span class="row-text">{side.difference}</span>
            </li>)}
          </ol>
        </section>)}
      </>)}
    </div>
  </div>
</div>

<style>
  /* minmax(0, 1fr): the horizontally scrolling chooser on phones must not
     widen the page. */
  .qc { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; }
  .qc-bar { position: sticky; top: 0; z-index: 15; margin: 0 -8px; padding: 10px 8px; background: var(--bg); border-bottom: 1px solid var(--line); }
  .picker { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .picker-label { flex: none; white-space: nowrap; font-weight: 700; margin-right: 4px; }
  .pick, .view, .row-pick { font: inherit; color: var(--ink); background: var(--surface); border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px; min-height: 40px; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; }
  .pick[aria-pressed='true'], .view[aria-pressed='true'] { border-color: var(--focus); color: var(--focus); font-weight: 700; box-shadow: inset 0 0 0 1px var(--focus); }
  .views { display: flex; flex-wrap: wrap; gap: 8px; }
  .dot { flex: none; width: 10px; height: 10px; border-radius: 50%; }

  .qc-layout { display: grid; grid-template-columns: minmax(0, 1fr) 240px; gap: 32px; align-items: start; }
  .qc-body { grid-column: 1; grid-row: 1; min-width: 0; display: grid; gap: 28px; }
  .qc-toc { grid-column: 2; grid-row: 1; position: sticky; top: calc(var(--bar-h, 60px) + 16px); max-height: calc(100vh - var(--bar-h, 60px) - 32px); overflow-y: auto; border-left: 1px solid var(--line); padding-left: 16px; font-size: 14px; }
  .qc-toc > summary { display: none; }
  .toc-group + .toc-group { margin-top: 16px; }
  .toc-title { margin: 0 0 6px; font-weight: 700; }
  .qc-toc ol { margin: 0; padding-left: 18px; display: grid; gap: 4px; }
  .qc-toc a { text-decoration: none; }
  .qc-toc a:hover { text-decoration: underline; }

  .qc-group { margin: 8px 0 0; padding-top: 12px; border-top: 2px solid var(--line); font-size: 24px; scroll-margin-top: calc(var(--bar-h, 60px) + 16px); }
  .question { max-width: var(--measure); scroll-margin-top: calc(var(--bar-h, 60px) + 16px); display: grid; gap: 12px; }
  .q-meta { margin: 0; color: var(--muted); font-size: 14px; }
  .question h3 { margin: 0; font-size: 22px; }
  .side { padding: 12px 16px; border: 1px solid var(--line); border-left: 4px solid var(--accent, var(--line)); border-radius: 6px; background: var(--surface); }
  .side.orthodox { border-left-color: var(--t-orthodoxy); }
  .side p { margin: 0 0 8px; line-height: 1.6; }
  .side p:last-child { margin-bottom: 0; }
  .who { display: flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 700; color: var(--muted); }
  .thesis { font-size: 17px; }
  .foundation-link, .analysis, .all-sources, .prayer-links { font-size: 15px; }
  .creed { margin: 0 0 10px; padding: 0; font-size: 17px; }
  .creed p { margin: 0 0 4px !important; font-style: italic; line-height: 1.55; }
  .plain-label { font-weight: 700; }
  .creed-n { font-style: normal; color: var(--muted); }
  .creed cite { display: block; font-style: normal; font-size: 13px; }
  .creed cite a { color: var(--muted); }
  .label { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); margin-top: 8px !important; }
  /* Three blocks per question (owner, 2026-10-09): Orthodox teaching, the
     chosen tradition's teaching, then where they part and the Orthodox
     answer, which stands out; only analysis links and sources fold. */
  .pair { display: grid; gap: 12px; }
  .pair[hidden] { display: none; }
  .side.verdict { border-left-color: var(--t-orthodoxy); background: color-mix(in srgb, var(--t-orthodoxy) 9%, var(--surface)); }
  .side.verdict .who { color: var(--ink); }
  .difference { font-size: 17px; font-weight: 700; }
  .more > summary { cursor: pointer; color: var(--focus); font-weight: 700; font-size: 15px; padding: 4px 0; }
  .more[open] > summary { margin-bottom: 8px; }
  .sources { margin: 0 0 8px; padding-left: 20px; font-size: 14px; }
  .sources li + li { margin-top: 2px; }

  .all-list { display: none; margin: 0; padding: 0; list-style: none; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); }
  .all-list li { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 12px; align-items: start; padding: 10px 14px; border-left: 4px solid var(--accent); }
  .all-list li + li { border-top: 1px solid var(--line); }
  .row-pick { border-radius: 4px; padding: 4px 8px; min-height: 36px; font-weight: 700; text-align: left; justify-content: flex-start; }
  .row-text { line-height: 1.55; }
  .qc[data-view='all'] .pair { display: none; }
  .qc[data-view='all'] .all-list { display: block; }

  @media (max-width: 760px) {
    .qc-bar { margin: 0 -16px; padding: 8px 16px; }
    .picker { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
    .picker::-webkit-scrollbar { display: none; }
    .pick { flex: none; }
    .qc-layout { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .qc-body { grid-row: 2; }
    .qc-toc { grid-column: 1; grid-row: 1; position: static; max-height: none; border: 1px solid var(--line); border-radius: 6px; padding: 0 16px; background: var(--surface); }
    .qc-toc > summary { display: list-item; cursor: pointer; padding: 12px 0; min-height: 48px; font-size: 16px; font-weight: 700; color: var(--focus); }
    .qc-toc nav { padding-bottom: 12px; }
    .qc-toc a { display: inline-block; padding: 6px 0; font-size: 16px; }
    .all-list li { grid-template-columns: minmax(0, 1fr); gap: 4px; }
    .more > summary { min-height: 44px; display: list-item; padding: 10px 0; font-size: 16px; }
    .sources { overflow-wrap: anywhere; }
  }
</style>

<script>
  import { getSelection, onSelection, setSelection } from '../lib/selection-client';

  const root = document.querySelector<HTMLElement>('[data-question-compare]');
  if (root) {
    const picks = [...root.querySelectorAll<HTMLButtonElement>('[data-pick]')];
    const pairs = [...root.querySelectorAll<HTMLElement>('.pair')];
    const viewButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-view-button]')];
    const toc = root.querySelector<HTMLDetailsElement>('.qc-toc');
    const narrow = matchMedia('(max-width: 760px)');
    // The sticky chooser wraps to one or two rows; headings and contents
    // stop below its actual height.
    const bar = root.querySelector<HTMLElement>('.qc-bar');
    if (bar) new ResizeObserver(() => root.style.setProperty('--bar-h', `${bar.offsetHeight}px`)).observe(bar);

    // The view is part of the address (?view=all), so a shared link opens it.
    const setView = (view: string, record = true) => {
      root.dataset.view = view === 'all' ? 'all' : 'one';
      viewButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.viewButton === root.dataset.view)));
      if (!record) return;
      const url = new URL(location.href);
      if (root.dataset.view === 'all') url.searchParams.set('view', 'all');
      else url.searchParams.delete('view');
      history.replaceState(history.state, '', url);
    };

    onSelection((ids) => {
      const chosen = ids[1] ?? '';
      root.dataset.chosen = chosen;
      pairs.forEach((pair) => { pair.hidden = pair.dataset.trad !== chosen; });
      picks.forEach((pick) => pick.setAttribute('aria-pressed', String(pick.dataset.pick === chosen)));
      if (!chosen) setView('all', false);
    });
    setView(new URLSearchParams(location.search).get('view') === 'all' || !getSelection()[1] ? 'all' : 'one', false);

    picks.forEach((pick) => pick.addEventListener('click', () => {
      setSelection(['orthodoxy', pick.dataset.pick ?? '']);
      setView('one');
    }));
    viewButtons.forEach((button) => button.addEventListener('click', () => setView(button.dataset.viewButton ?? 'one')));
    // Choosing a religion from «Этот вопрос у всех» opens it on the same question.
    root.addEventListener('click', (event) => {
      const row = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-pick-row]');
      if (!row) return;
      const question = row.closest<HTMLElement>('.question');
      setSelection(['orthodoxy', row.dataset.pickRow ?? '']);
      setView('one');
      question?.scrollIntoView({ block: 'start' });
    });

    if (toc) {
      const sync = () => { toc.open = !narrow.matches; };
      narrow.addEventListener('change', sync);
      toc.addEventListener('click', (event) => { if (narrow.matches && (event.target as HTMLElement).closest('a')) toc.open = false; });
      sync();
    }
  }
</script>
