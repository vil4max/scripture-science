---
// Inline glossary hints (docs/tasks/site-m34-newcomer-reading.md, outcome 3):
// the first mention of a glossary term in the reading area becomes a button
// that shows the term's plain explanation and a link to the glossary. This is
// progressive enhancement: the HTML text, anchors and links stay unchanged.
import { getTerms } from '../lib/content';
import { withBase } from '../lib/paths';

const hints = (await getTerms())
  .filter((entry) => entry.data.match.length > 0)
  .map((entry) => ({
    term: entry.data.term,
    short: entry.data.short,
    href: withBase(`terms/#${entry.data.slug}`),
    match: entry.data.match,
  }));
---
<script type="application/json" id="term-hints-data" set:html={JSON.stringify(hints).replace(/</g, '\\u003c')} />
<div id="term-hint-pop" class="term-hint-pop" popover="auto" role="dialog" aria-label="Пояснение термина">
  <p class="term-hint-name"></p>
  <p class="term-hint-short"></p>
  <a class="term-hint-link" href="#">В словарь →</a>
</div>

<script>
  interface Hint { term: string; short: string; href: string; match: string[] }

  // Text in these places is never annotated: navigation and controls, headings,
  // quotations and source lists, and anything already annotated. Hidden blocks,
  // captions and another tradition's own teaching are skipped too: the glossary
  // gives Orthodox definitions, which must not land on another church's name
  // (site audit 2026-10-10, T1-2, S2-3).
  const SKIP = 'a, button, summary, h1, h2, h3, h4, h5, h6, nav, header, script, style, svg, blockquote, q, cite, details.proof, .accessed, .term-hint, .term-hint-pop, [data-no-terms], [hidden], figcaption, select, option, label, .side.tradition';
  const LETTER = String.raw`[\p{L}\p{N}]`;

  const annotate = () => {
    const root = document.querySelector<HTMLElement>('main');
    const data = document.getElementById('term-hints-data');
    const pop = document.getElementById('term-hint-pop') as HTMLElement | null;
    if (!root || !data || !pop || root.closest('[data-no-terms]') || !('showPopover' in pop)) return;
    const hints = JSON.parse(data.textContent ?? '[]') as Hint[];

    const textNodes = (includeFolded: boolean) => {
      const nodes: Text[] = [];
      const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
        acceptNode(node) {
          const parent = node.parentElement;
          if (!parent || !node.nodeValue?.trim() || parent.closest(SKIP)) return NodeFilter.FILTER_REJECT;
          // Prefer visible text: a closed disclosure's body is searched only
          // when the term appears nowhere else.
          if (!includeFolded) {
            const folded = parent.closest('details:not([open])');
            if (folded && !parent.closest('summary')) return NodeFilter.FILTER_REJECT;
          }
          return NodeFilter.FILTER_ACCEPT;
        },
      });
      while (walker.nextNode()) nodes.push(walker.currentNode as Text);
      return nodes;
    };

    const used: Hint[] = [];
    for (const hint of hints) {
      const pattern = new RegExp(`(?<!${LETTER})(?:${hint.match.join('|')})(?!${LETTER})`, 'u');
      const found = [false, true].some((includeFolded) => {
        for (const node of textNodes(includeFolded)) {
          const match = pattern.exec(node.nodeValue ?? '');
          if (!match) continue;
          const word = node.splitText(match.index);
          word.splitText(match[0].length);
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'term-hint';
          button.dataset.hint = String(used.length);
          button.setAttribute('aria-haspopup', 'dialog');
          button.setAttribute('aria-expanded', 'false');
          button.textContent = word.nodeValue;
          word.replaceWith(button);
          return true;
        }
        return false;
      });
      if (found) used.push(hint);
    }

    let owner: HTMLButtonElement | null = null;
    const place = () => {
      if (!owner) return;
      const box = owner.getBoundingClientRect();
      const width = Math.min(340, window.innerWidth - 24);
      pop.style.width = `${width}px`;
      pop.style.left = `${Math.max(12, Math.min(box.left, window.innerWidth - width - 12))}px`;
      const below = box.bottom + 8;
      const height = pop.offsetHeight;
      pop.style.top = `${below + height > window.innerHeight - 8 ? Math.max(8, box.top - height - 8) : below}px`;
    };
    root.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button.term-hint');
      if (!button) return;
      const hint = used[Number(button.dataset.hint)];
      if (!hint) return;
      if (owner === button && pop.matches(':popover-open')) { pop.hidePopover(); return; }
      owner?.setAttribute('aria-expanded', 'false');
      owner = button;
      pop.querySelector('.term-hint-name')!.textContent = hint.term;
      pop.querySelector('.term-hint-short')!.textContent = hint.short;
      pop.querySelector<HTMLAnchorElement>('.term-hint-link')!.href = hint.href;
      // Keep keyboard order: the dialog follows its button in the document.
      button.after(pop);
      pop.showPopover();
      place();
      button.setAttribute('aria-expanded', 'true');
    });
    pop.addEventListener('toggle', (event) => {
      if ((event as ToggleEvent).newState === 'closed') owner?.setAttribute('aria-expanded', 'false');
    });
    window.addEventListener('scroll', () => { if (pop.matches(':popover-open')) pop.hidePopover(); }, { passive: true });
    window.addEventListener('resize', place);
  };

  if ('requestIdleCallback' in window) requestIdleCallback(annotate, { timeout: 1500 });
  else setTimeout(annotate, 200);
</script>

<style is:global>
  .term-hint {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    margin: 0;
    cursor: help;
    text-decoration: underline dotted;
    text-decoration-color: var(--focus);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }
  .term-hint:hover, .term-hint[aria-expanded='true'] { color: var(--focus); }
  .term-hint:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; border-radius: 2px; }
  .term-hint-pop {
    position: fixed;
    inset: auto;
    margin: 0;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-left: 4px solid var(--t-orthodoxy);
    border-radius: 6px;
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 8px 28px rgb(0 0 0 / 0.18);
    font-size: 16px;
    line-height: 1.5;
  }
  .term-hint-pop p { margin: 0 0 8px; }
  .term-hint-name { font-weight: 700; }
  .term-hint-link { font-weight: 700; }
</style>
