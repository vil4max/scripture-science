---
import type { CollectionEntry } from 'astro:content';
import MatrixPosition from './MatrixPosition.astro';
import { DEFAULT_SELECTION } from '../lib/selection';
import { comparisonQuestionView } from '../lib/disputes';
interface Props {
  dispute: CollectionEntry<'disputes'>;
  order: string[];
  namesById: Map<string, string>;
  colorById: Map<string, string>;
  comparison?: boolean;
}
const { dispute, order, namesById, colorById, comparison = false } = Astro.props;
const initial = comparisonQuestionView({ challengers: dispute.data.challenges.map(p => p.tradition), answerers: dispute.data.answers.map(p => p.tradition) }, DEFAULT_SELECTION);
const supplied = [...dispute.data.challenges, ...dispute.data.answers];
const parts = ['orthodoxy', ...order.filter(id => id !== 'orthodoxy')].flatMap(id => {
  const part = supplied.find(part => part.tradition === id);
  if (!part) return [];
  return [{ id, position: { ...part, topic: dispute.data.topic, status: dispute.data.status },
    role: id === 'orthodoxy' ? 'Православный ответ' : 'В чём отличие: позиция по этому вопросу' }];
});
---
<aside id={`question-${dispute.id}`} class="dispute" data-dispute hidden={comparison && !initial.visible}
  data-challengers={dispute.data.challenges.map((part) => part.tradition).join(' ')}
  data-answerers={dispute.data.answers.map((part) => part.tradition).join(' ')}>
  <details class="discussion">
    <summary>Разбор вопроса: {dispute.data.title}</summary>
    <div class="foundation"><h5>Православное учение</h5><p>{dispute.data.orthodoxFoundation}</p><p class="role">{dispute.data.authority}</p></div>
    <div class:list={["side", { "slot-columns": comparison }]}>
      {parts.map((part) => <article class="part" data-trad={part.id} hidden={comparison && !initial.shown.includes(part.id)} style={comparison ? `grid-column:${DEFAULT_SELECTION.indexOf(part.id) + 1};grid-row:1` : undefined}>
        <p class="who"><span class="chip" style={`background:var(${colorById.get(part.id) ?? '--t-other'})`} aria-hidden="true" />{namesById.get(part.id) ?? part.id}</p>
        <p class="role">{part.role}</p>
        <MatrixPosition position={part.position} />
      </article>)}
    </div>
  </details>
</aside>
<style>
  .dispute { margin-top: 20px; border-top: 1px solid var(--line); padding-top: 16px; scroll-margin-top: calc(var(--comparison-header-h, 0px) + 16px); }
  .dispute[hidden], .part[hidden] { display: none; }
  summary { cursor: pointer; color: var(--focus); font-weight: 700; }
  .side { margin-top: 16px; display: grid; gap: 20px; align-items: start; }
  .side.slot-columns { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .part { min-width: 0; padding: 16px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); }
  .who { margin: 0; font-weight: 700; display: flex; gap: 8px; align-items: center; }
  .chip { width: 12px; height: 12px; border-radius: 50%; flex: none; }
  .role, .missing { font-size: 14px; color: var(--muted); margin: 8px 0 12px; }
</style>
