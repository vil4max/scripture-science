---
// The chosen traditions side by side (docs/tasks/site-m14-selection.md W3):
// one column per chosen tradition in the reader's order, each fact on one
// row across the columns so the same fact is read at the same height. The
// columns share their template with the topics and the pinned column header
// on /compare/, like a product comparison table. Every
// tradition is rendered; the script shows the selected comparison columns.
import type { CollectionEntry } from 'astro:content';
import OrthodoxClassification from './OrthodoxClassification.astro';
import { DEFAULT_SELECTION } from '../lib/selection';
import { sinceLines } from '../lib/rules';

interface Props {
  traditions: CollectionEntry<'matrix'>[];
}

const { traditions } = Astro.props;
const rows = ['family', 'since', 'adherents', 'scripture', 'self'] as const;
const rowLabel: Record<(typeof rows)[number], string> = {
  since: 'Возникновение',
  adherents: 'Численность',
  scripture: 'Писание',
  self: 'Сама о себе',
  family: 'Классификация',
};
---

<section id="chosen" aria-labelledby="chosen-title">
  <h2 id="chosen-title">Основные сведения</h2>
  <p class="hint" data-tcompare-hint hidden>
    Выберите традицию в любой колонке.
  </p>
  <div class="tcompare" data-tcompare style="--cols:3">
  {
    rows.map((row) => (
      <div class="frow">
        <span class="flabel">{rowLabel[row]}</span>
        {traditions.map((t) => {
          const { since, scripture, adherents, self_view } = t.data;
          return (
            <div class="cell" data-trad={t.id} data-foundation-column={t.id === 'orthodoxy' ? '' : undefined} hidden={!DEFAULT_SELECTION.includes(t.id)} style={`order:${DEFAULT_SELECTION.indexOf(t.id)};grid-column:${DEFAULT_SELECTION.indexOf(t.id)+1};grid-row:2`}>
              <p class="mobile-name">{t.data.name}</p>
              {row === 'since' && (
                <>
                  {sinceLines(since.label).map((line) => (
                    <p class="line">{line}</p>
                  ))}
                </>
              )}
              {row === 'adherents' && (
                <>
                  <p class="line">{adherents.value}</p>
                  {adherents.scopeNote && <p class="line scope">{adherents.scopeNote}</p>}
                </>
              )}
              {row === 'scripture' && scripture.comparison && (
                <>
                  <p class="line"><strong>Общее:</strong> {scripture.comparison.common}</p>
                  <p class="line"><strong>Различие:</strong> {scripture.comparison.difference}</p>
                </>
              )}
              {row === 'scripture' && !scripture.comparison && (
                <>
                  {scripture.overview ? (
                    <>
                      <p class="line"><strong>{scripture.overview.title}</strong></p>
                      <p class="line">{scripture.overview.text}</p>
                    </>
                  ) : <p class="line">{scripture.name}</p>}
                </>
              )}
              {row === 'self' && (
                <>
                  <p class="line">{self_view.summary}</p>
                </>
              )}
              {row === 'family' && <OrthodoxClassification tradition={t.id} />}
            </div>
          );
        })}
      </div>
    ))
  }
  </div>
</section>

<script>
  import { comparisonSlots, SLOT_PARAM } from '../lib/comparisonSlots';
  import { onSelection } from '../lib/selection-client';

  const root = document.querySelector<HTMLElement>('[data-tcompare]');
  const hint = document.querySelector<HTMLElement>('[data-tcompare-hint]');
  if (root) {
    onSelection((ids) => {
      root.hidden = ids.length === 0;
      if (hint) hint.hidden = ids.length > 0;
      const slots = comparisonSlots(ids, new URLSearchParams(location.search).get(SLOT_PARAM));
      root.style.setProperty('--cols', '3');
      for (const cell of root.querySelectorAll<HTMLElement>('.cell')) {
        const index = slots.indexOf(cell.dataset.trad ?? '');
        cell.hidden = index === -1;
        cell.style.order = String(index);
        cell.style.gridColumn = String(index + 1);
        cell.style.gridRow = '2';
      }
    });
  }
</script>

<style>

  #chosen {
    scroll-margin-top: calc(var(--comparison-header-h, 0px) + 16px);
  }

  .scope {
    font-size: 14px;
    color: var(--muted);
  }
  .tcompare[hidden] {
    display: none;
  }

  .tcompare {
    margin-top: 20px;
    border: 1px solid var(--line);
    border-left: 4px solid var(--t-orthodoxy);
    background: var(--surface);
  }

  .hint {
    margin: 0;
    color: var(--muted);
  }

  /* Every fact row is its own grid with the same template, so the columns
  line up across rows while explicit grid positions preserve empty slots. */
  .frow {
    display: grid;
    grid-template-columns: repeat(var(--cols, 1), minmax(0, 1fr));
    column-gap: 0;
    row-gap: 0;
    margin: 0;
    border-bottom: 1px solid var(--line);
  }

  .frow:last-child { border-bottom: 0; }

  /* The fact's name heads its row across all columns. */
  .flabel {
    grid-column: 1 / -1;
    order: -1;
    color: var(--ink);
    font-size: 18px;
    font-weight: 700;
    padding: 12px 16px;
    background: color-mix(in srgb, var(--focus) 12%, var(--surface));
    border-bottom: 1px solid var(--line);
  }

  .cell { padding: 16px; min-width: 0; }
  .cell:not([data-foundation-column]) { border-left: 1px solid var(--line); }
  .cell[data-foundation-column] { background: color-mix(in srgb, var(--t-orthodoxy) 8%, var(--surface)); }

  .family-path {
    list-style: none;
    margin: 0;
    padding: 0;
    line-height: 1.45;
  }

  .family-path li + li::before {
    content: '↓';
    display: block;
    margin: 4px 0;
    color: var(--muted);
    font-size: 16px;
  }

  .family-path li:last-child {
    font-weight: 700;
  }

  .cell[hidden] {
    display: none;
  }

  .cell h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 21px;
  }

  .chip {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    flex: none;
  }

  .full-name {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 15px;
  }

  .line {
    margin: 0 0 4px;
    line-height: 1.6;
  }


  .muted {
    color: var(--muted);
  }


  /* The name reads as text; the link to the translation stays small, so a
  long name is not one underlined block (owner, 2026-09-26). */
  .open {
    font-size: 14px;
    color: var(--focus);
    white-space: nowrap;
  }

  .mobile-name { display: none; }
  @media (max-width: 760px) {
    .frow { display: flex; flex-direction: column; }
    .mobile-name { display: block; font-weight: 700; margin: 0 0 10px; }
    .cell:not([data-foundation-column]) { border-left: 0; border-top: 1px solid var(--line); }
  }
</style>
