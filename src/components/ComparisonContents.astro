---
import { TOPIC_GROUPS, TOPIC_TITLES_RU } from '../lib/rules';
---

<nav class="contents" aria-labelledby="comparison-contents-title">
  <h2 id="comparison-contents-title">Содержание</h2>
  <div class="groups">
    <section class="group" style="--group-accent:var(--t-orthodoxy)">
      <a class="group-title" href="#chosen">Основные сведения</a>
      <p>Классификация, возникновение, численность, Писание и самоописание.</p>
    </section>
    {TOPIC_GROUPS.map((group, index) => <section class="group" style={`--group-accent:var(${['--t-orthodoxy', '--t-catholicism', '--t-jw'][index]})`}>
      <a class="group-title" href={`#group-${group.id}`}>{group.title}</a>
      <div class="topic-links">
        {group.topics.map((topic) => <a href={`#topic-${topic}`}>{TOPIC_TITLES_RU[topic]}</a>)}
      </div>
    </section>)}
  </div>
</nav>

<style>
  .contents { margin: 8px 0 36px; }
  .contents > h2 { margin: 0 0 14px; font-size: 25px; }
  .topic-links a {
    color: var(--ink);
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
  }
  .groups { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
  .group { min-width: 0; padding: 13px; border: 1px solid var(--line); border-top: 3px solid var(--group-accent); background: var(--surface); }
  .group-title { display: inline-block; margin-bottom: 10px; color: var(--ink); font-weight: 700; text-underline-offset: 3px; }
  .group p { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.4; }
  .topic-links { display: flex; flex-wrap: wrap; gap: 6px; }
  .topic-links a { padding: 4px 8px; color: var(--muted); font-size: 13px; line-height: 1.25; }
  .topic-links a:hover, .topic-links a:focus-visible { border-color: var(--focus); color: var(--focus); }
</style>
