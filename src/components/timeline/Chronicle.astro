---
// The biblical comparison line is explicitly distinguished from historical branches.
import { withBase } from '../../lib/paths';
import lineageData from '../../data/lineage.json';
import biblical from '../../data/biblical-timeline.json';
import chapters from '../../data/history-overview.json';
const biblicalById = new Map(biblical.map((row) => [row.id, row]));
const contextByRow = new Map(chapters.filter((chapter) => chapter.timelineRow && chapter.id !== 'orthodoxy').map((chapter) => [chapter.timelineRow, chapter]));
import {
  assignBranchColumns,
  buildChronicleRows,
  formatHistoricalYear,
  formatYearAd,
  parseLineage,
  validateReferences,
  type ChronicleRow,
  type LineageNode,
} from '../../lib/timeline';

const lineage = parseLineage(lineageData);
validateReferences(lineage);
const rows = buildChronicleRows(lineage, biblical).filter((row) => row.kind !== 'epoch');
const branches = assignBranchColumns(lineage, rows);
const nodeById = new Map(lineage.nodes.map((n) => [n.id, n]));

// --- Highlight sets: a tradition's own nodes plus every ancestor line ----
const ancestorsOf = (node: LineageNode): string[] => {
  const ids: string[] = [];
  for (let n: LineageNode | undefined = node; n; n = n.parent ? nodeById.get(n.parent) : undefined) ids.push(n.id);
  return ids;
};
const highlightOf = new Map<string, Set<string>>(); // node id -> traditions
for (const n of lineage.nodes) {
  if (!n.tradition) continue;
  for (const id of ancestorsOf(n)) {
    highlightOf.set(id, (highlightOf.get(id) ?? new Set()).add(n.tradition));
  }
}
function rowHighlight(row: ChronicleRow): string {
  if (row.kind === 'node') return [...(highlightOf.get(row.id) ?? [])].join(' ');
  if (row.kind === 'union') {
    const u = lineage.unions.find((x) => x.id === row.id)!;
    return [nodeById.get(u.from)?.tradition, nodeById.get(u.to)?.tradition].filter(Boolean).join(' ');
  }
  return row.tradition ?? '';
}

// --- Graph geometry (CSS pixels) -------------------------------------------
const COL_W = 12;
const GRAPH_PAD = 8;
const GRAPH_W = GRAPH_PAD * 2 + (branches.columns + 1) * COL_W;
const BIBLICAL_X = GRAPH_PAD + COL_W / 2;
// The dot sits on the first text line's centre: row padding 6 + half of the
// 26px line height.
const DOT_Y = 19;
// The first lineage column is the biblical line itself. The apostolic Church
// continues that trunk; Judaism and later separations leave it as branches.
const colX = (c: number) => BIBLICAL_X + c * COL_W;
const colorOf = (tradition?: string) => `var(--t-${tradition ?? 'other'})`;
const branchColor = new Map<string, string>([
  ['rabbinic-judaism', 'light-dark(#4338ca, #818cf8)'],
  ['church-of-the-east', 'light-dark(#6d28d9, #a78bfa)'],
  ['oriental-orthodoxy', 'light-dark(#0f766e, #2dd4bf)'],
  ['old-believers', 'light-dark(#9a3412, #fdba74)'],
  ['reformation', 'light-dark(#b91c1c, #fb7185)'],
  ['lutheran', 'light-dark(#c2410c, #fb923c)'],
  ['reformed', 'light-dark(#1d4ed8, #60a5fa)'],
  ['anabaptist', 'light-dark(#a16207, #facc15)'],
  ['anglican', 'light-dark(#7e22ce, #d8b4fe)'],
  ['pentecostalism', 'light-dark(#0e7490, #22d3ee)'],
  ['second-great-awakening', 'light-dark(#475569, #cbd5e1)'],
  ['sunni', 'light-dark(#15803d, #4ade80)'],
  ['shia', 'light-dark(#4d7c0f, #a3e635)'],
]);
const colorOfNode = (node: LineageNode) => node.id === 'early-christianity'
  ? 'var(--testament-new)'
  : branchColor.get(node.id) ?? colorOf(node.tradition);
const chipColorOfNode = (node: LineageNode) => node.id === 'early-christianity'
  ? colorOf('orthodoxy')
  : colorOfNode(node);
const nativityIndex = rows.findIndex((row) => row.id === 'biblical-nativity');
const bibleEnd = rows.findIndex((row) => row.id === 'early-christianity');
const testamentOf = (row: ChronicleRow) => row.id === 'early-christianity' || row.id === 'biblical-nativity'
  ? 'new' : row.kind === 'biblical' ? 'old' : undefined;
const testamentColor = (testament: 'old' | 'new') => `var(--testament-${testament})`;

interface Segment {
  x: number;
  from: 'top' | 'dot';
  to: 'bottom' | 'dot';
  color: string;
  hl: string;
  trunk?: boolean;
}
interface Connector {
  x1: number;
  x2: number;
  color: string;
  hl: string;
  dashed?: boolean;
}

/** The vertical line pieces crossing row `r`. */
function segmentsAt(r: number): Segment[] {
  const out: Segment[] = [];
  if (r <= bibleEnd) out.push({ x: BIBLICAL_X,
    from: r > 0 ? 'top' : 'dot', to: r === bibleEnd ? 'dot' : 'bottom',
    color: testamentColor(r < nativityIndex ? 'old' : 'new'), hl: 'biblical', trunk: true });
  for (const n of lineage.nodes) {
    const [a, b] = branches.span.get(n.id)!;
    const hl = [...(highlightOf.get(n.id) ?? [])].join(' ');
    const base = { x: colX(branches.column.get(n.id)!), color: colorOfNode(n), hl, trunk: n.id === 'early-christianity' };
    if (n.id === 'israelite-second-temple') continue;
    if (r < a || r > b) continue;
    // A living line runs on through the "now" row; a structural line ends
    // on the dot of its last child's row (branches.living, src/lib/timeline.ts).
    const living = branches.living.has(n.id);
    if (r === a) {
      if (living || b > a) out.push({ ...base, from: 'dot', to: 'bottom' });
    } else if (r === b && !living) out.push({ ...base, from: 'top', to: 'dot' });
    else out.push({ ...base, from: 'top', to: 'bottom' });
  }
  return out;
}

function connectorAt(row: ChronicleRow): Connector | undefined {
  if (row.kind === 'node') {
    const n = nodeById.get(row.id)!;
    if (!n.parent) return undefined;
    const x1 = colX(branches.column.get(n.parent)!);
    const x2 = colX(branches.column.get(n.id)!);
    if (x1 === x2) return undefined;
    return { x1, x2, color: colorOfNode(n), hl: rowHighlight(row) };
  }
  if (row.kind === 'union') {
    const u = lineage.unions.find((x) => x.id === row.id)!;
    return {
      x1: colX(branches.column.get(u.from)!),
      x2: colX(branches.column.get(u.to)!),
      color: 'var(--muted)',
      hl: rowHighlight(row),
      dashed: true,
    };
  }
  return undefined;
}

function dotAt(row: ChronicleRow): { x: number; color: string; trunk?: boolean } | undefined {
  if (row.kind === 'biblical') return { x: BIBLICAL_X, color: testamentColor(testamentOf(row)!), trunk: true };
  if (row.kind === 'node') return {
    x: colX(branches.column.get(row.id)!),
    color: row.id === 'israelite-second-temple' ? testamentColor('old') : colorOfNode(nodeById.get(row.id)!),
    trunk: row.id === 'israelite-second-temple' || row.id === 'early-christianity',
  };
  if (row.kind === 'union') {
    const u = lineage.unions.find((x) => x.id === row.id)!;
    return { x: colX(branches.column.get(u.to)!), color: 'var(--muted)' };
  }
  return undefined;
}

type Item = { row: ChronicleRow; index: number };
const items: Item[] = [];
rows.forEach((row, index) => {
  items.push({ row, index });
});

// Living lines end on the "now" row's dot.
const nowSegments: Segment[] = lineage.nodes
  .filter((n) => branches.living.has(n.id))
  .map((n) => ({
    x: colX(branches.column.get(n.id)!),
    from: 'top' as const,
    to: 'dot' as const,
    color: colorOfNode(n),
    hl: [...(highlightOf.get(n.id) ?? [])].join(' '),
    trunk: n.id === 'early-christianity',
  }));

// A static site knows the current year at build time.
const today = new Date();
---

<div class="chronicle" data-chronicle>
  <p class="biblical-key"><strong>Как читать даты.</strong> Ранние события обозначены годами от Сотворения мира (от С. М.) по византийской эре; с первого года христианского летосчисления — от Рождества Христова (от Р. Х.). Под годом от Сотворения мира мелко указан тот же год в привычном счёте — до Рождества Христова (до Р. Х.). Для библейской линии использована «Хронология Септуагинты». Вера в сотворение мира Богом — церковное учение; конкретное вычисление лет от Сотворения мира — хронологическая традиция. Для дат без месяца принят отсчёт января–августа; с сентября византийский год увеличивается на один.</p>
  <div class="testament-key" aria-label="Библейское повествование">
    <span class="old">Ветхий Завет · от Сотворения мира</span>
    <span class="new">Новый Завет · от Рождества Христова</span>
  </div>
  <ol class="rows" style={`--graph-w: ${GRAPH_W}px`}>
    {
      items.map((item) => {
        const { row, index } = item;
        const context = contextByRow.get(row.id);
        const dot = dotAt(row);
        const connector = connectorAt(row);
        const about = row.approx ? 'ок. ' : '';
        return (
          <li class={`row ${row.kind}${index === 0 ? ' start' : ''}${row.id === 'catholicism' ? ' major-schism' : ''}`} id={context ? `history-${context.id}` : undefined} data-row-id={row.id} data-testament={testamentOf(row)} data-hl={rowHighlight(row)}>
            <span class="ad" id={row.id === 'early-christianity' ? 'history-orthodoxy' : undefined}>
              {about}
              {formatHistoricalYear(row.year)}
              {row.year < 0 && <span class="ad-gloss">{about}{formatYearAd(row.year)}</span>}
            </span>
            <span class="graph" aria-hidden="true">
              {segmentsAt(index).map((s) => (
                <span
                  class={`seg ${s.from}-${s.to}${s.trunk ? ' main-trunk' : ''}`}
                  data-hl={s.hl}
                  style={`left:${s.x - (s.trunk ? 2.5 : 1)}px; background:${s.color}; --dot-y:${DOT_Y}px`}
                />
              ))}
              {connector && (
                <span
                  class={connector.dashed ? 'conn dashed' : 'conn'}
                  data-hl={connector.hl}
                  style={`left:${Math.min(connector.x1, connector.x2)}px; width:${Math.abs(connector.x2 - connector.x1)}px; top:${DOT_Y - 1}px; --c:${connector.color}`}
                />
              )}
              {dot && (
                <span class={`dot${dot.trunk ? ' main-trunk' : ''}`} data-hl={rowHighlight(row)} style={`left:${dot.x - (dot.trunk ? 7 : 5)}px; top:${DOT_Y - (dot.trunk ? 7 : 5)}px; background:${dot.color}`} />
              )}
            </span>
            <span class="text">
              {testamentOf(row) && <span class="biblical-label">{testamentOf(row) === 'old' ? 'Ветхий Завет' : 'Новый Завет'}</span>}
              {row.kind === 'node' && <span class="chip" style={`background:${chipColorOfNode(nodeById.get(row.id)!)}`} aria-hidden="true" />}
              <b class="title">{row.title}</b>
              {row.text && <span class="event"> — {row.text}</span>}
              {row.todo && <span class="todo"> (уточняется)</span>}
              {biblicalById.get(row.id)?.description && <span class="context">{biblicalById.get(row.id)!.description}</span>}
              {context && <span class="context">{context.timelineText}</span>}
              {context?.milestones && <details class="milestones">
                <summary>Дальнейшая история</summary>
                <ul>{context.milestones.map((event) => <li><strong>{event.year}</strong> — {event.text}</li>)}</ul>
                <a href={withBase('bible/#scripture-new-world')}>История «Перевода нового мира»</a>
              </details>}
            </span>
          </li>
        );
      })
    }
    <li class="divider now" id="history-today">
      <span class="ad">{formatHistoricalYear(today.getFullYear())}</span>
      <span class="graph" aria-hidden="true">
        {nowSegments.map((s) => (
          <span class={`seg top-dot${s.trunk ? ' main-trunk' : ''}`} data-hl={s.hl} style={`left:${s.x - (s.trunk ? 2.5 : 1)}px; background:${s.color}; --dot-y:${DOT_Y}px`} />
        ))}
      </span>
      <span class="text">Наши дни</span>
    </li>
  </ol>

</div>

<style>
  .chronicle {
    --testament-old: var(--focus);
    --testament-new: light-dark(#245b94, #8bbef2);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
  }

  .rows > li {
    display: grid;
    grid-template-columns: 170px var(--graph-w) minmax(0, 1fr);
    column-gap: 12px;
    padding: 6px 16px 6px 12px;
    line-height: 26px;
    font-size: 17px;
    transition: opacity 0.15s ease;
  }

  .rows > li + li {
    border-top: 1px solid color-mix(in srgb, var(--line) 50%, transparent);
  }

  .ad {
    font-variant-numeric: tabular-nums;
    text-align: right;
    white-space: normal;
  }

  .ad {
    color: var(--muted);
  }

  /* The same year in the familiar count, for readers who do not use the
     Byzantine era (docs/tasks/site-m34-newcomer-reading.md). */
  .ad-gloss {
    display: block;
    font-size: 13px;
  }

  .graph {
    position: relative;
    align-self: stretch;
    margin: -6px 0;
  }

  .seg {
    position: absolute;
    width: 2px;
  }

  .seg.main-trunk {
    width: 5px;
    border-radius: 3px;
    z-index: 2;
  }

  .seg.full,
  .seg.top-bottom {
    top: 0;
    bottom: 0;
  }

  /* The graph cell spans the row's 6px vertical padding (negative margin
  above), so y = 0 is the row's top edge and --dot-y the dot's centre. */
  .seg.dot-bottom {
    top: var(--dot-y);
    bottom: 0;
  }

  .seg.top-dot {
    top: 0;
    height: var(--dot-y);
  }

  .conn {
    position: absolute;
    height: 2px;
    background: var(--c);
  }

  .conn.dashed {
    background: repeating-linear-gradient(90deg, var(--c) 0 4px, transparent 4px 7px);
  }

  .dot {
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--surface);
    z-index: 3;
  }

  .dot.main-trunk {
    width: 14px;
    height: 14px;
    box-shadow: 0 0 0 3px var(--surface);
  }

  .milestones { margin-top: 12px; font-size: 16px; }
  .milestones summary { cursor: pointer; color: var(--focus); }
  .milestones ul { padding-left: 20px; }
  .context { display: block; font-size: 16px; font-weight: 400; line-height: 1.55; margin-top: 8px; color: var(--ink); }
  .rows > li[id] { scroll-margin-top: 60px; }

  .text {
    min-width: 0;
  }

  .chip {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 3px;
    margin-right: 8px;
    vertical-align: 1px;
  }

  .todo {
    color: var(--focus);
    font-size: 14px;
  }

  .row.other,
  .row.epoch,
  .row.union {
    color: var(--muted);
  }

  .row.other .title {
    font-family: Georgia, serif;
    font-size: 19px;
    font-weight: 700;
    color: var(--ink);
  }

  .row.union .title { color: var(--ink); }

  .row.major-schism {
    background: color-mix(in srgb, var(--t-catholicism) 14%, var(--surface));
    box-shadow: inset 5px 0 0 var(--t-catholicism);
  }

  .row.major-schism .title {
    color: var(--t-catholicism);
    font-size: 19px;
    letter-spacing: 0.01em;
  }

  .row.epoch .title {
    font-weight: 400;
    font-style: italic;
  }

  .row.start {
    color: var(--ink);
  }

  .row.start .title {
    color: var(--ink);
    font-style: normal;
    font-weight: 700;
  }

  .rows > li.divider {
    color: var(--muted);
    font-size: 15px;
  }

  .rows > li.divider.now {
    color: var(--ink);
    font-weight: 700;
    background: color-mix(in srgb, var(--ink) 5%, transparent);
  }

  [data-testament="old"] { --testament-color: var(--testament-old); }
  [data-testament="new"] { --testament-color: var(--testament-new); }
  .row[data-testament] { background: color-mix(in srgb, var(--testament-color) 7%, var(--surface)); }
  .testament-key { display: flex; flex-wrap: wrap; gap: 12px 24px; font-size: 14px; }
  .testament-key span { display: flex; align-items: center; gap: 8px; }
  .testament-key span::before { content: ''; width: 24px; height: 3px; background: currentColor; }
  .testament-key .old { color: var(--testament-old); }
  .testament-key .new { color: var(--testament-new); }
  .biblical-label { display: block; color: var(--testament-color); font-size: 13px; line-height: 18px; }
  .row.biblical .text { padding-top: 0; }
  .biblical-key { margin: 0; max-width: 85ch; font-size: 15px; }


  @media (prefers-reduced-motion: reduce) {
    .rows > li {
      transition: none;
    }
  }

  @media (max-width: 760px) {
    .rows > li { grid-template-columns: calc(var(--graph-w) * .4) minmax(0, 1fr); gap: 0 8px; padding-right: 10px; padding-left: 8px; }
    .graph { grid-column: 1; grid-row: 1 / 3; width: var(--graph-w); transform: scaleX(.4); transform-origin: left; }
    .ad { grid-column: 2; grid-row: 1; text-align: left; white-space: normal; font-size: 15px; }
    .text { grid-column: 2; grid-row: 2; }
  }
</style>
