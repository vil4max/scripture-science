---
import type { CollectionEntry } from 'astro:content';

import SourceLink from './SourceLink.astro';
import ProofLink from './ProofLink.astro';
import { UNITY_LABEL_RU, positionSummaryText } from '../lib/rules';

interface Props {
  tradition?: string;
  expandable?: boolean;
  compact?: boolean;
  position: CollectionEntry<'matrix'>['data']['positions'][number];
}

const { position, expandable = false, compact = false } = Astro.props;
const summary = positionSummaryText(position);
// A fold hides only what is long: a position whose evidence is just its
// source line shows that line directly (owner, 2026-10-01).
const hasLongEvidence = Boolean(
  position.doctrine?.sections.length || position.quote || position.scripture
  || (summary && position.unity?.kind === 'divided'),
);
const EvidenceTag = expandable && hasLongEvidence ? 'details' : 'div';
const quoteText = position.quote?.text_ru ?? position.quote?.text;
const scriptureText = position.scripture?.text_ru ?? position.scripture?.text;
const quoteInSummary = Boolean(quoteText && summary?.includes(quoteText));
const scriptureInQuote = Boolean(scriptureText && quoteText?.includes(scriptureText));
---

<div class="body">
  {summary ? (
    <p class="summary">{summary}</p>
  ) : (
    <p class="todo-flag">Источник уточняется</p>
  )}
  {!compact && position.doctrine && <p class="unity">{position.doctrine.authority}</p>}
  {!compact && <EvidenceTag class="evidence">
    {expandable && hasLongEvidence && <summary>Обоснование и цитаты</summary>}
    {position.doctrine?.sections.map(section => <section><h5>{section.title}</h5><p>{section.text}</p></section>)}
  {summary && position.unity?.kind === 'divided' && (
    <p class={`unity ${position.unity.kind}`}>
      <span class="unity-label">{UNITY_LABEL_RU[position.unity.kind]}</span><span>: {position.unity.note}</span>
      <ProofLink
        proof={position.unity.proof}
        exclude={[position.quote?.url, position.scripture?.url, ...position.proof.map((item) => item.url)].filter(
          (u): u is string => Boolean(u),
        )}
        inline
      />
    </p>
  )}
  {/* Detailed reading keeps quotes open, set apart by style; the attribution is the link to
  the source (owner, 2026-09-26). */}
  {position.quote && !quoteInSummary && (
    <blockquote class="quote">
      <p>«{position.quote.text_ru ?? position.quote.text}»</p>
      <cite>
        —{' '}
        <SourceLink url={position.quote.url} title={position.quote.source} />
        {position.quote.translation && <span class="translation"> · {position.quote.translation}</span>}
        <ProofLink
          proof={position.proof}
          exclude={[position.quote.url, position.scripture?.url].filter((u): u is string => Boolean(u))}
          inline
        />
      </cite>
    </blockquote>
  )}
  {position.scripture && !scriptureInQuote && (
    <blockquote class="quote scripture">
      <p>«{position.scripture.text_ru ?? position.scripture.text}»</p>
      <cite>
        —{' '}
        <SourceLink url={position.scripture.url} title={position.scripture.ref} />
        {position.scripture.translation && <span class="translation"> · {position.scripture.translation}</span>}
      </cite>
    </blockquote>
  )}
  {position.quote && quoteInSummary && <cite class="inline-source">
    <SourceLink url={position.quote.url} title={position.quote.source} />
    {position.quote.translation && <span class="translation"> · {position.quote.translation}</span>}
    <ProofLink proof={position.proof} exclude={[position.quote.url, position.scripture?.url].filter((u): u is string => Boolean(u))} inline />
  </cite>}
  {!position.quote && !position.scripture && position.proof.length > 0 && <p class="inline-source">Основание: <SourceLink url={position.proof[0].url} title={position.proof[0].title} /></p>}
  {!position.quote && (
    <span>
    <ProofLink
      proof={position.proof}
      exclude={[position.scripture?.url].filter((u): u is string => Boolean(u))}
    />
    </span>
  )}

  </EvidenceTag>}
</div>

<style>
  .evidence > summary { cursor: pointer; color: var(--focus); font-size: 15px; font-weight: 700; }
  .evidence[open] > summary { margin-bottom: 12px; }
  .inline-source { font-size: 14px; color: var(--muted); font-style: normal; }
  .body {
    display: grid;
    gap: 8px;
    align-content: start;
  }

  .summary {
    margin: 0;
    line-height: 1.6;
  }

  .todo-flag {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
    color: var(--focus);
  }

  .unity {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }

  .unity-label {
    font-weight: 700;
    color: var(--ink);
  }

  .unity.divided .unity-label {
    color: var(--focus);
  }

  .unity :global(.proof-inline a) {
    color: var(--focus);
    text-decoration: none;
  }

  /* An open quote: set apart by a rule and italics, attributed with a link
  to its source. */
  .quote {
    margin: 10px 0 0;
    padding: 2px 0 2px 14px;
    border-left: 3px solid color-mix(in srgb, var(--ink) 25%, transparent);
  }

  .quote p {
    margin: 0;
    font-style: italic;
    line-height: 1.6;
  }

  .quote cite {
    display: block;
    margin-top: 4px;
    font-style: normal;
    font-size: 14px;
    color: var(--muted);
  }

  .quote cite a {
    color: var(--focus);
    text-decoration: none;
  }

  .quote cite a:hover {
    text-decoration: underline;
  }
</style>
