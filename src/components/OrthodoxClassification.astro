---
import entries from '../data/orthodox-classifications.json';
interface Props { tradition: string; }
const entry = entries[Astro.props.tradition as keyof typeof entries];
---
{entry && <div class="classification"><strong>{entry.label}</strong><p>{entry.text}</p><a class="details" href={entry.url}>Подробнее</a></div>}
<style>p { margin: 8px 0; line-height: 1.6; } .details { font-size: 14px; color: var(--focus); }</style>
