---
// Sitewide sidebar (docs/tasks/site-m13-sidebar-sections.md): the site's
// sections as pages, the current one highlighted, and the theme switch.
// Below 1000px it becomes a top bar with the same links in a row; nothing
// folds or nests (owner, 2026-09-26: «не усложняй вложением»); the religions
// group is a second flat list under a small label.
import ThemeSwitch from './ThemeSwitch.astro';
import { getOrderedMatrix } from '../lib/content';
import { withBase } from '../lib/paths';
import { TRADITION_COLOR_TOKEN } from '../lib/rules';

// Orthodoxy is the site's foundation, so it has its own item; the other
// traditions' pages open from «Религии мира» and the comparison
// (owner, 2026-10-01).
const sections = [
  { path: '', label: 'Религии мира' },
  { path: 'orthodoxy/', label: 'Православная вера' },
  { path: 'compare/', label: 'Сравнение' },
  { path: 'timeline/', label: 'История' },
  { path: 'bible/', label: 'Священное Писание' },
];
// The pages of the other traditions, by age, in short names (owner,
// 2026-10-01: they need a way in from the menu). Each page holds that
// tradition's detailed analysis.
const SHORT_NAMES: Record<string, string> = {
  judaism: 'Иудаизм', catholicism: 'Католичество', islam: 'Ислам', protestantism: 'Протестантизм',
  lds: 'Святые последних дней', adventism: 'Адвентисты', jw: 'Свидетели Иеговы',
};
const religions = (await getOrderedMatrix())
  .filter((tradition) => tradition.id !== 'orthodoxy')
  .map((tradition) => ({
    path: `traditions/${tradition.id}/`,
    label: SHORT_NAMES[tradition.id] ?? tradition.data.name,
    color: TRADITION_COLOR_TOKEN[tradition.data.id],
  }));
// Reference pages sit at the bottom of the sidebar (owner, 2026-09-26:
// «глоссарий источники это доп инфо которую можно опустить вниз»).
const reference = [
  { path: 'sources/', label: 'Термины и источники' },
];

// Compare paths with one trailing slash, so "/religion-map" and
// "/religion-map/" both mark «Религии мира» as current.
const normalise = (p: string) => p.replace(/\/*$/, '/');
const here = normalise(Astro.url.pathname);
// The detailed pair documents are part of «Сравнение»
// (owner, 2026-09-26: one comparison section).
const isCurrent = (path: string) =>
  normalise(withBase(path)) === here ||
  (path === 'compare/' && here.startsWith(normalise(withBase('pairs/'))));
---

<aside class="site-side">
  <div class="side-inner">
    <a class="search-link" href={withBase('search/')} data-carry-selection>Найти вопрос</a>
    <a class="brand" href={withBase()}>Православный взгляд на религии мира</a>
    <div class="site-nav" role="navigation" aria-label="Разделы сайта">
      <ul>
        {
          sections.map((s) => (
            <li>
              <a href={withBase(s.path)} aria-current={isCurrent(s.path) ? 'page' : undefined} data-carry-selection>
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="religions site-nav" role="navigation" aria-label="Религии">
      <p class="group-label">Религии</p>
      <ul>
        {
          religions.map((r) => (
            <li>
              <a href={withBase(r.path)} aria-current={isCurrent(r.path) ? 'page' : undefined} data-carry-selection>
                <span class="chip" style={`background:var(${r.color})`} aria-hidden="true" />
                {r.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="reference site-nav" role="navigation" aria-label="Термины и источники">
      <ul>
        {
          reference.map((s) => (
            <li>
              <a href={withBase(s.path)} aria-current={isCurrent(s.path) ? 'page' : undefined} data-carry-selection>
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="theme">
      <ThemeSwitch />
    </div>
  </div>
</aside>

<script>
  import { getSelection } from '../lib/selection-client';
  getSelection();
</script>

<style>
  .site-side {
    background: var(--surface);
    border-right: 1px solid var(--line);
  }

  .side-inner {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 24px 20px;
  }

  .search-link { padding: 8px 12px; border: 1px solid var(--line); border-radius: 8px; font-size: 16px; text-decoration: none; }

  .brand {
    font-family: 'PT Serif', Georgia, serif;
    font-weight: 700;
    font-size: 20px;
    line-height: 1.25;
    text-decoration: none;
  }

  .site-nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 2px;
  }

  .site-nav a {
    display: block;
    padding: 8px 12px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.3;
  }

  .site-nav a:hover {
    color: var(--ink);
    background: color-mix(in srgb, var(--ink) 6%, transparent);
  }

  .site-nav a[aria-current='page'] {
    color: var(--ink);
    font-weight: 700;
    background: color-mix(in srgb, var(--ink) 10%, transparent);
  }

  /* The religions group: a small label over a flat list with a colour dot
  per tradition, no nesting. */
  .religions {
    border-top: 1px solid var(--line);
    padding-top: 12px;
  }

  .group-label {
    margin: 0 0 6px;
    padding: 0 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .religions a {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    padding: 6px 12px;
  }

  .chip {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex: none;
  }

  /* Terms and sources sit apart at the bottom, under a thin rule, with no
  heading and no nesting (owner, 2026-09-26). */
  .reference {
    border-top: 1px solid var(--line);
    padding-top: 12px;
  }

  .reference a {
    font-size: 13px;
    color: var(--muted);
    padding: 8px;
  }

  .reference a[aria-current='page'] {
    color: var(--muted);
    font-weight: 400;
    background: none;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Desktop: a fixed column the height of the window, beside the page. */
  @media (min-width: 1000px) {
    .site-side {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow-y: auto;
    }

    .reference {
      margin-top: auto;
    }

    .side-inner {
      min-height: 100%;
    }
  }

  /* Narrower windows: a top bar with the same links in one wrapping row. */
  @media (max-width: 999px) {
    .site-side {
      border-right: none;
      border-bottom: 1px solid var(--line);
    }

    .side-inner {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      padding: 12px 16px;
      gap: 8px 16px;
    }

    .site-nav ul {
      display: flex;
      flex-wrap: wrap;
      gap: 2px 4px;
    }

    /* Still a rule, not a heading or a nested menu (owner, 2026-09-26: «не
    усложняй вложением») - just turned to match the row: a left border
    instead of a top one, so terms/sources keep reading as extra material
    next to the main sections, not one more section. */
    .reference,
    .religions {
      border-top: none;
      padding-top: 0;
      border-left: 1px solid var(--line);
      padding-left: 16px;
    }

    .group-label {
      display: none;
    }
  }
</style>
