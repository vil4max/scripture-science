---
// The menu is the reading route (owner, 2026-10-09: on the iPhone the menu
// was confusing, had no roadmap and showed the comparison twice): three
// numbered parts in reading order, each religion's own page under the
// comparison, and the reference pages apart at the bottom.
import ThemeSwitch from './ThemeSwitch.astro';
import { getOrderedMatrix } from '../lib/content';
import { withBase } from '../lib/paths';
import { ROUTE } from '../lib/route';
import { TRADITION_COLOR_TOKEN } from '../lib/rules';

// The pages of the other traditions, by age, in short names (owner,
// 2026-10-01: they need a way in from the menu). Each page holds that
// tradition's detailed analysis.
const SHORT_NAMES: Record<string, string> = {
  judaism: 'Иудаизм', catholicism: 'Католичество', islam: 'Ислам', protestantism: 'Протестантизм',
  lds: 'Святые последних дней', adventism: 'Адвентисты', jw: 'Свидетели Иеговы',
};
const religions = (await getOrderedMatrix())
  .filter((tradition) => tradition.id !== 'orthodoxy')
  .map((tradition) => ({
    path: `traditions/${tradition.id}/`,
    label: SHORT_NAMES[tradition.id] ?? tradition.data.name,
    color: TRADITION_COLOR_TOKEN[tradition.data.id],
  }));
// Reference pages sit at the bottom (owner, 2026-09-26: «глоссарий источники
// это доп инфо которую можно опустить вниз»).
const reference = [
  { path: 'reading/', label: 'Как читать сравнение' },
  { path: 'terms/', label: 'Словарь' },
  { path: 'sources/', label: 'Источники' },
];

// Compare paths with one trailing slash, so "/scripture-science" and
// "/scripture-science/" both mark the homepage as current.
const normalise = (p: string) => p.replace(/\/*$/, '/');
const here = normalise(Astro.url.pathname);
// The retired pair documents are part of the comparison.
const isCurrent = (path: string) =>
  normalise(withBase(path)) === here ||
  (path === 'compare/' && here.startsWith(normalise(withBase('pairs/'))));
const last = ROUTE.length - 1;
---

<aside class="site-side">
  <div class="side-inner">
    <a class="brand" href={withBase()}>Православный взгляд на религии мира</a>
    <a class="search-link" href={withBase('search/')} data-carry-selection>Найти вопрос</a>
    <button class="menu-toggle" type="button" aria-controls="site-menu" aria-expanded="true" hidden>Меню</button>
    <nav id="site-menu" class="site-menu" aria-label="Разделы сайта">
      <a class="home" href={withBase()} aria-current={isCurrent('') ? 'page' : undefined} data-carry-selection>Главная</a>
      <ol class="parts">
        {ROUTE.map((part, partIndex) => (
          <li class="part">
            <p class="part-title"><span class="part-number">{partIndex + 1}</span>{part.title}</p>
            <ul class="steps">
              {part.steps.map((step) => (
                <li><a href={withBase(step.path)} aria-current={isCurrent(step.path) ? 'page' : undefined} data-carry-selection>{step.label}</a></li>
              ))}
            </ul>
            {partIndex === last && (
              <>
                <p class="sub-title">Каждая религия подробно</p>
                <ul class="religions">
                  {religions.map((r) => (
                    <li>
                      <a href={withBase(r.path)} aria-current={isCurrent(r.path) ? 'page' : undefined} data-carry-selection>
                        <span class="chip" style={`background:var(${r.color})`} aria-hidden="true" />
                        {r.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </li>
        ))}
      </ol>
      <div class="reference">
        <p class="sub-title">Справка</p>
        <ul>
          {reference.map((s) => (
            <li><a href={withBase(s.path)} aria-current={isCurrent(s.path) ? 'page' : undefined} data-carry-selection>{s.label}</a></li>
          ))}
        </ul>
      </div>
      <div class="theme"><ThemeSwitch /></div>
    </nav>
  </div>
</aside>

<script>
  import { getSelection } from '../lib/selection-client';
  getSelection();
  const sidebar = document.querySelector<HTMLElement>('.site-side')!;
  const toggle = sidebar.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const narrow = matchMedia('(max-width: 999px)');
  const setOpen = (open: boolean) => {
    sidebar.dataset.menuOpen = String(open);
    toggle.setAttribute('aria-expanded', String(open));
  };
  const resizeMenu = () => { toggle.hidden = !narrow.matches; setOpen(!narrow.matches); };
  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  sidebar.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && narrow.matches) { setOpen(false); toggle.focus(); }
  });
  narrow.addEventListener('change', resizeMenu);
  resizeMenu();
</script>

<style>
  .site-side {
    background: var(--surface);
    border-right: 1px solid var(--line);
  }

  .side-inner {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px 20px;
  }

  .brand {
    font-family: 'PT Serif', Georgia, serif;
    font-weight: 700;
    font-size: 20px;
    line-height: 1.25;
    text-decoration: none;
  }

  .search-link { padding: 8px 12px; border: 1px solid var(--line); border-radius: 8px; font-size: 16px; text-decoration: none; }

  .site-menu { display: grid; gap: 14px; }

  .site-menu ul, .parts {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 2px;
  }

  .parts { gap: 14px; }

  .site-menu a {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding: 6px 12px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.3;
  }

  .site-menu a:hover {
    color: var(--ink);
    background: color-mix(in srgb, var(--ink) 6%, transparent);
  }

  .site-menu a[aria-current='page'] {
    color: var(--ink);
    font-weight: 700;
    background: color-mix(in srgb, var(--ink) 10%, transparent);
  }

  /* A part: its number and title as a heading, its pages indented under
  it, so the menu reads as the route 1 → 2 → 3. */
  .part-title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 4px;
    padding: 0 12px;
    font-weight: 700;
    color: var(--ink);
  }

  .part-number {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1px solid var(--focus);
    color: var(--focus);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }

  .site-menu .steps { margin-left: 22px; border-left: 1px solid var(--line); padding-left: 6px; }

  .sub-title {
    margin: 10px 0 4px;
    padding: 0 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .site-menu .religions { margin-left: 22px; padding-left: 6px; }
  .religions a { font-size: 15px; }

  .chip {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex: none;
  }

  /* Terms and sources sit apart at the bottom, under a thin rule (owner,
  2026-09-26). */
  .reference { border-top: 1px solid var(--line); padding-top: 4px; }
  .reference a { font-size: 14px; }

  /* Desktop: a fixed column the height of the window, beside the page. */
  @media (min-width: 1000px) {
    .site-side {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow-y: auto;
    }
  }

  /* Phones and tablets: a top bar with the title, search and a menu button
  that opens the same route. */
  @media (max-width: 999px) {
    .site-side { border-right: none; border-bottom: 1px solid var(--line); }
    .side-inner { display: grid; grid-template-columns: minmax(0, 1fr) auto; padding: 16px; gap: 10px; }
    .brand { grid-column: 1 / -1; }
    .search-link { grid-column: 1; min-height: 44px; display: flex; align-items: center; }
    .menu-toggle { grid-column: 2; min-height: 44px; padding: 8px 18px; border: 1px solid var(--line); border-radius: 8px; font: inherit; color: var(--ink); background: var(--bg); }
    .menu-toggle[hidden] { display: none; }
    .site-menu { grid-column: 1 / -1; padding-top: 6px; }
    .site-menu a { min-height: 44px; }
    .site-menu .religions { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .reference ul { display: flex; flex-wrap: wrap; gap: 0 4px; }
    .site-side[data-menu-open='false'] .site-menu { display: none; }
    .theme :global(button) { min-height: 44px; }
  }
</style>
