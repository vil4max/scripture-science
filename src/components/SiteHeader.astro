---
// Sitewide sidebar (docs/tasks/site-m13-sidebar-sections.md): the site's
// sections as pages, the current one highlighted, and the theme switch.
// Below 1000px it becomes a top bar with the same links in a row; nothing
// folds or nests (owner, 2026-09-26: «не усложняй вложением»).
// The navigation is a plain, ARIA-labelled list - not a <nav> element - on
// purpose: scripts/check_text.py locates the page's *first* <nav> (and
// first <main>) to compare against source/orthodoxy-jw.html, and on the
// pair page that must stay the page's own local chips nav
// (src/pages/pairs/orthodoxy-jw.astro), not this sitewide one. `role="navigation"`
// keeps the same accessibility landmark without the tag collision.
import ThemeSwitch from './ThemeSwitch.astro';
import { withBase } from '../lib/paths';

const sections = [
  { path: '', label: 'Обзор' },
  { path: 'timeline/', label: 'История' },
  { path: 'bible/', label: 'Писания' },
  { path: 'compare/', label: 'Сравнение' },
];
// Reference pages sit at the bottom of the sidebar (owner, 2026-09-26:
// «глоссарий источники это доп инфо которую можно опустить вниз»).
const reference = [
  { path: 'sources/', label: 'Термины и источники' },
];

// Compare paths with one trailing slash, so "/religion-map" and
// "/religion-map/" both mark «Обзор» as current.
const normalise = (p: string) => p.replace(/\/*$/, '/');
const here = normalise(Astro.url.pathname);
// The detailed pair documents are part of «Сравнение»
// (owner, 2026-09-26: one comparison section).
const isCurrent = (path: string) =>
  normalise(withBase(path)) === here || (path === 'compare/' && here.startsWith(normalise(withBase('pairs/'))));
---

<aside class="site-side">
  <div class="side-inner">
    <a class="brand" href={withBase()}>Религии мира</a>
    <div class="site-nav" role="navigation" aria-label="Разделы сайта">
      <ul>
        {
          sections.map((s) => (
            <li>
              <a href={withBase(s.path)} aria-current={isCurrent(s.path) ? 'page' : undefined} data-carry-selection>
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="reference site-nav" role="navigation" aria-label="Термины и источники">
      <ul>
        {
          reference.map((s) => (
            <li>
              <a href={withBase(s.path)} aria-current={isCurrent(s.path) ? 'page' : undefined} data-carry-selection>
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="theme">
      <ThemeSwitch />
    </div>
  </div>
</aside>

<style>
  .site-side {
    background: var(--surface);
    border-right: 1px solid var(--line);
  }

  .side-inner {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 24px 20px;
  }

  .brand {
    font-family: 'PT Serif', Georgia, serif;
    font-weight: 700;
    font-size: 20px;
    line-height: 1.25;
    text-decoration: none;
  }

  .site-nav ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 2px;
  }

  .site-nav a {
    display: block;
    padding: 8px 12px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.3;
  }

  .site-nav a:hover {
    color: var(--ink);
    background: color-mix(in srgb, var(--ink) 6%, transparent);
  }

  .site-nav a[aria-current='page'] {
    color: var(--ink);
    font-weight: 700;
    background: color-mix(in srgb, var(--ink) 10%, transparent);
  }

  /* Terms and sources sit apart at the bottom, under a thin rule, with no
  heading and no nesting (owner, 2026-09-26). */
  .reference {
    border-top: 1px solid var(--line);
    padding-top: 12px;
  }

  .reference a {
    font-size: 13px;
    color: var(--muted);
    padding: 8px;
  }

  .reference a[aria-current='page'] {
    color: var(--muted);
    font-weight: 400;
    background: none;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Desktop: a fixed column the height of the window, beside the page. */
  @media (min-width: 1000px) {
    .site-side {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow-y: auto;
    }

    .reference {
      margin-top: auto;
    }

    .side-inner {
      min-height: 100%;
    }
  }

  /* Narrower windows: a top bar with the same links in one wrapping row. */
  @media (max-width: 999px) {
    .site-side {
      border-right: none;
      border-bottom: 1px solid var(--line);
    }

    .side-inner {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      padding: 12px 16px;
      gap: 8px 16px;
    }

    .site-nav ul {
      display: flex;
      flex-wrap: wrap;
      gap: 2px 4px;
    }

    /* Still a rule, not a heading or a nested menu (owner, 2026-09-26: «не
    усложняй вложением») - just turned to match the row: a left border
    instead of a top one, so terms/sources keep reading as extra material
    next to the main sections, not one more section. */
    .reference {
      border-top: none;
      padding-top: 0;
      border-left: 1px solid var(--line);
      padding-left: 16px;
    }
  }
</style>
