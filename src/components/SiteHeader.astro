---
// The menu is the reading route (owner, 2026-10-09: on the iPhone the menu
// was confusing, had no roadmap and showed the comparison twice): three
// numbered parts in reading order, each religion's own page under the
// comparison, and the reference pages apart at the bottom.
import ThemeSwitch from './ThemeSwitch.astro';
import { getOrderedMatrix } from '../lib/content';
import { SHORT_NAMES } from '../lib/names';
import { withBase } from '../lib/paths';
import { ROUTE } from '../lib/route';
import { TRADITION_COLOR_TOKEN } from '../lib/rules';

// The pages of the other traditions, by age, in short names (owner,
// 2026-10-01: they need a way in from the menu). Each page holds that
// tradition's detailed analysis.
const religions = (await getOrderedMatrix())
  .filter((tradition) => tradition.id !== 'orthodoxy')
  .map((tradition) => ({
    path: `traditions/${tradition.id}/`,
    label: SHORT_NAMES[tradition.id] ?? tradition.data.name,
    color: TRADITION_COLOR_TOKEN[tradition.data.id],
  }));
// Reference pages sit at the bottom (owner, 2026-09-26: «глоссарий источники
// это доп инфо которую можно опустить вниз»).
const reference = [
  { path: 'reading/', label: 'Как читать сравнение' },
  { path: 'terms/', label: 'Словарь' },
  { path: 'sources/', label: 'Источники' },
  // The one book the site draws on at length (owner, 2026-10-17).
  { path: 'books/homo-religiosus/', label: 'Книга «Homo religiosus»' },
];

// Compare paths with one trailing slash, so "/scripture-science" and
// "/scripture-science/" both mark the homepage as current.
const normalise = (p: string) => p.replace(/\/*$/, '/');
const here = normalise(Astro.url.pathname);
// The retired pair documents are part of the comparison.
const isCurrent = (path: string) =>
  normalise(withBase(path)) === here ||
  (path === 'compare/' && here.startsWith(normalise(withBase('pairs/'))));
const last = ROUTE.length - 1;
---

<aside class="site-side" data-menu-open="false">
  <div class="side-inner">
    <a class="brand" href={withBase()}>Православный взгляд на религии мира</a>
    <a class="search-link" href={withBase('search/')} data-carry-selection>Найти вопрос</a>
    <button class="menu-toggle" type="button" aria-controls="site-menu" aria-expanded="true" hidden>Меню</button>
    <nav id="site-menu" class="site-menu" aria-label="Разделы сайта">
      <div class="drawer-head"><span>Разделы сайта</span><button class="menu-close" type="button">Закрыть</button></div>
      <a class="home" href={withBase()} aria-current={isCurrent('') ? 'page' : undefined} data-carry-selection>Главная</a>
      <ol class="parts">
        {ROUTE.map((part, partIndex) => (
          <li class="part">
            <p class="part-title"><span class="part-number">{partIndex + 1}</span>{part.title}</p>
            <ul class="steps">
              {part.steps.map((step) => (
                <li><a href={withBase(step.path)} aria-current={isCurrent(step.path) ? 'page' : undefined} data-carry-selection>{step.label}</a></li>
              ))}
            </ul>
            {partIndex === last && (
              <>
                <p class="sub-title">Каждая религия подробно</p>
                <ul class="religions">
                  {religions.map((r) => (
                    <li>
                      <a href={withBase(r.path)} aria-current={isCurrent(r.path) ? 'page' : undefined} data-carry-selection>
                        <span class="chip" style={`background:var(${r.color})`} aria-hidden="true" />
                        {r.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </li>
        ))}
      </ol>
      <div class="reference">
        <p class="sub-title">Справка</p>
        <ul>
          {reference.map((s) => (
            <li><a href={withBase(s.path)} aria-current={isCurrent(s.path) ? 'page' : undefined} data-carry-selection>{s.label}</a></li>
          ))}
        </ul>
      </div>
      <div class="theme"><ThemeSwitch /></div>
    </nav>
    <button class="menu-backdrop" type="button" tabindex="-1" aria-label="Закрыть меню" hidden></button>
  </div>
  <button class="menu-fab" type="button" aria-controls="site-menu" aria-expanded="false" hidden><span aria-hidden="true">☰</span> Меню</button>
</aside>

<script>
  import { getSelection } from '../lib/selection-client';
  getSelection();
  // On phones and tablets the menu is a drawer over the page, reachable from
  // a floating button anywhere on a long page (owner, 2026-10-12: navigation
  // on the iPhone was inconvenient).
  const sidebar = document.querySelector<HTMLElement>('.site-side')!;
  const toggle = sidebar.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const fab = sidebar.querySelector<HTMLButtonElement>('.menu-fab')!;
  const menu = sidebar.querySelector<HTMLElement>('#site-menu')!;
  const close = sidebar.querySelector<HTMLButtonElement>('.menu-close')!;
  const backdrop = sidebar.querySelector<HTMLButtonElement>('.menu-backdrop')!;
  const narrow = matchMedia('(max-width: 999px)');
  let opener: HTMLElement = toggle;
  const setOpen = (open: boolean) => {
    sidebar.dataset.menuOpen = String(open);
    for (const button of [toggle, fab]) button.setAttribute('aria-expanded', String(open));
    const drawer = open && narrow.matches;
    backdrop.hidden = !drawer;
    document.documentElement.classList.toggle('menu-locked', drawer);
    if (drawer) {
      menu.querySelector<HTMLElement>('[aria-current="page"]')?.scrollIntoView({ block: 'center' });
      close.focus();
    }
  };
  const updateFab = () => { fab.hidden = !narrow.matches || window.scrollY < 300; };
  const resizeMenu = () => { toggle.hidden = !narrow.matches; setOpen(!narrow.matches); updateFab(); };
  for (const button of [toggle, fab]) button.addEventListener('click', () => { opener = button; setOpen(button.getAttribute('aria-expanded') !== 'true'); });
  const shut = () => { if (!narrow.matches) return; setOpen(false); opener.focus(); };
  close.addEventListener('click', shut);
  backdrop.addEventListener('click', shut);
  menu.addEventListener('click', (event) => { if ((event.target as HTMLElement).closest('a')) shut(); });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && sidebar.dataset.menuOpen === 'true') shut(); });
  window.addEventListener('scroll', updateFab, { passive: true });
  narrow.addEventListener('change', resizeMenu);
  resizeMenu();
</script>

<style>
  .site-side {
    background: var(--surface);
    border-right: 1px solid var(--line);
  }

  .side-inner {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px 20px;
  }

  .brand {
    font-family: 'PT Serif', Georgia, serif;
    font-weight: 700;
    font-size: 20px;
    line-height: 1.25;
    text-decoration: none;
  }

  .search-link { padding: 8px 12px; border: 1px solid var(--line); border-radius: 8px; font-size: 16px; text-decoration: none; }

  .site-menu { display: grid; gap: 14px; }

  .site-menu ul, .parts {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 2px;
  }

  .parts { gap: 14px; }

  .site-menu a {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 40px;
    padding: 6px 12px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.3;
  }

  .site-menu a:hover {
    color: var(--ink);
    background: color-mix(in srgb, var(--ink) 6%, transparent);
  }

  .site-menu a[aria-current='page'] {
    color: var(--ink);
    font-weight: 700;
    background: color-mix(in srgb, var(--ink) 10%, transparent);
  }

  /* A part: its number and title as a heading, its pages indented under
  it, so the menu reads as the route 1 → 2 → 3. */
  .part-title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 4px;
    padding: 0 12px;
    font-weight: 700;
    color: var(--ink);
  }

  .part-number {
    display: inline-grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1px solid var(--focus);
    color: var(--focus);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }

  .site-menu .steps { margin-left: 22px; border-left: 1px solid var(--line); padding-left: 6px; }

  .sub-title {
    margin: 10px 0 4px;
    padding: 0 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .site-menu .religions { margin-left: 22px; padding-left: 6px; }
  .religions a { font-size: 15px; }

  .chip {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex: none;
  }

  /* Terms and sources sit apart at the bottom, under a thin rule (owner,
  2026-09-26). */
  .reference { border-top: 1px solid var(--line); padding-top: 4px; }
  .reference a { font-size: 14px; }

  /* Desktop: a fixed column the height of the window, beside the page. */
  @media (min-width: 1000px) {
    .site-side {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow-y: auto;
    }
  }

  /* Phones and tablets: a top bar with the title, search and a menu button
  that opens the same route. */
  @media (max-width: 999px) {
    .site-side { border-right: none; border-bottom: 1px solid var(--line); }
    .side-inner { display: grid; grid-template-columns: minmax(0, 1fr) auto; padding: 16px; gap: 10px; }
    .brand { grid-column: 1 / -1; }
    .search-link { grid-column: 1; min-height: 44px; display: flex; align-items: center; }
    .menu-toggle { grid-column: 2; min-height: 44px; padding: 8px 18px; border: 1px solid var(--line); border-radius: 8px; font: inherit; color: var(--ink); background: var(--bg); }
    .menu-toggle[hidden] { display: none; }
    /* The menu is a drawer from the left over the page, with a dimmed
       backdrop; the page behind does not scroll while it is open. */
    .site-menu {
      position: fixed; top: 0; bottom: 0; left: 0; z-index: 60;
      width: min(86vw, 340px); overflow-y: auto; overscroll-behavior: contain;
      padding: 12px 12px 32px; background: var(--surface);
      border-right: 1px solid var(--line); box-shadow: 0 0 32px color-mix(in srgb, #000 40%, transparent);
    }
    .drawer-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 4px 0 8px 12px; font-weight: 700; }
    .menu-close { min-height: 44px; padding: 8px 14px; border: 1px solid var(--line); border-radius: 8px; font: inherit; color: var(--ink); background: var(--bg); }
    .menu-backdrop { position: fixed; inset: 0; z-index: 55; border: 0; padding: 0; background: color-mix(in srgb, #000 45%, transparent); }
    .menu-backdrop[hidden] { display: none; }
    .site-menu a { min-height: 44px; }
    .site-menu .religions { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .reference ul { display: flex; flex-wrap: wrap; gap: 0 4px; }
    .site-side[data-menu-open='false'] .site-menu { display: none; }
    .theme :global(button) { min-height: 44px; }
    :global(html.menu-locked) { overflow: hidden; }
    .menu-fab {
      position: fixed; left: 16px; bottom: 24px; z-index: 20;
      display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 10px 14px;
      border: 1px solid var(--focus); border-radius: 999px; color: var(--focus); background: var(--surface);
      box-shadow: 0 8px 24px color-mix(in srgb, #000 35%, transparent); font: inherit; font-weight: 700; cursor: pointer;
    }
    .menu-fab[hidden] { display: none; }
  }
  @media (min-width: 1000px) {
    .drawer-head, .menu-backdrop, .menu-fab { display: none; }
  }
  @media (max-width: 999px) and (prefers-reduced-motion: no-preference) {
    .site-side[data-menu-open='true'] .site-menu { animation: drawer-in 0.18s ease-out; }
    @keyframes drawer-in { from { transform: translateX(-100%); } }
  }
</style>
