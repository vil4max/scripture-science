<script>
  import { readingState, readingUrl } from '../lib/comparisonReading';
  const root = document.querySelector<HTMLElement>('[data-comparison]');
  if (root) {
    const state = readingState(location.search, location.hash);
    history.replaceState(history.state, '', readingUrl(location.href, state.topic));
    const revealAnchor = () => {
      const target = document.getElementById(location.hash.slice(1));
      if (!target) return;
      for (let parent: HTMLElement | null = target; parent; parent = parent.parentElement) {
        if (parent instanceof HTMLDetailsElement) parent.open = true;
      }
      requestAnimationFrame(() => {
        // An anchor inside a hidden pair lands on its question (site audit S2-21).
        const destination = target.closest('[hidden]') ? target.closest('.question') ?? target : target;
        destination.scrollIntoView();
      });
    };
    window.addEventListener('hashchange', revealAnchor);
    if (location.hash) revealAnchor();
  }
</script>
